@@ -0,0 +1,50 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include "video_core/coherent_read.h"
+
+#define CHECK(condition) do { if (!(condition)) { \
+    std::fprintf(stderr, "Failed at line %d: %s\n", __LINE__, #condition); std::abort(); \
+} } while (false)
+
+int main() {
+    std::array<unsigned char, 8> guest{1, 2, 3, 4, 5, 6, 7, 8};
+    auto backing = guest;
+    const auto address = reinterpret_cast<std::uintptr_t>(guest.data());
+    int checks = 0;
+    int lookups = 0;
+    bool current = true;
+    bool shared = true;
+    auto is_current = [&](std::uintptr_t a, std::uint64_t size) {
+        ++checks;
+        CHECK(a == address && size == guest.size());
+        return current;
+    };
+    auto find_backing = [&](std::uintptr_t a, std::uint64_t size) -> const void* {
+        ++lookups;
+        CHECK(a == address && size == guest.size());
+        return shared ? backing.data() : nullptr;
+    };
+    using VideoCore::CoherentReadPointer;
+    CHECK(CoherentReadPointer(address, 8, false, is_current, find_backing) == guest.data());
+    CHECK(checks == 0 && lookups == 0);
+    CHECK(CoherentReadPointer(address, 0, true, is_current, find_backing) == guest.data());
+    CHECK(checks == 0 && lookups == 0);
+    current = false; // GPU-dirty bytes or any pending asynchronous copy must use guest reads.
+    CHECK(CoherentReadPointer(address, 8, true, is_current, find_backing) == guest.data());
+    CHECK(checks == 1 && lookups == 0);
+    current = true;
+    shared = false; // Executable, unmapped or noncontiguous physical backing is rejected.
+    CHECK(CoherentReadPointer(address, 8, true, is_current, find_backing) == guest.data());
+    CHECK(checks == 2 && lookups == 1);
+    shared = true;
+    const void* selected = CoherentReadPointer(address, 8, true, is_current, find_backing);
+    CHECK(selected == backing.data());
+    CHECK(checks == 3 && lookups == 2);
+    CHECK(std::memcmp(selected, guest.data(), guest.size()) == 0);
+    return 0;
+}
diff --git a/tests/test_combined_readback.cpp b/tests/test_combined_readback.cpp
new file mode 100644
index 00000000..70616e60
--- /dev/null
+++ b/tests/test_combined_readback.cpp
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <array>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include "video_core/coherent_read.h"
+#include "video_core/buffer_cache/download_overlap.h"
+#include "video_core/buffer_cache/download_rescan.h"
+#include "video_core/buffer_cache/readback_window.h"
+#include "video_core/texture_cache/lookup_reuse.h"
+#define CHECK(c) do { if (!(c)) {std::fprintf(stderr,"line %d: %s\n",__LINE__,#c);std::abort();} } while(false)
+int main() {
+    using namespace VideoCore;
+    std::array<unsigned char,32> guest{}, backing{};
+    const auto address=reinterpret_cast<std::uintptr_t>(guest.data());
+    PendingBackingCopies copies;
+    bool gpu_dirty=false;
+    auto current=[&](auto addr,auto size){return !gpu_dirty && !copies.Overlaps(addr,size);};
+    auto shared=[&](auto addr,auto size)->const void* {
+        CHECK(addr==address && size==guest.size());return backing.data();
+    };
+    CHECK(CoherentReadPointer(address,guest.size(),true,current,shared)==backing.data());
+    const std::array pending{std::pair{address+8,address+16}};
+    copies.Add(1,pending); // a partial copy blocks hashing the entire image
+    CHECK(CoherentReadPointer(address,guest.size(),true,current,shared)==guest.data());
+    LookupReuseEntry<TextureLookupKey,int> lookup;
+    TextureLookupKey key{};lookup.Store(key,10,42);
+    CHECK(*lookup.Find(key,10)==42); // cache hit must not replace the memory coherency check
+    CHECK(CoherentReadPointer(address,guest.size(),true,current,shared)==guest.data());
+    std::atomic<std::uint64_t> epoch{};
+    DownloadRescan rescan;
+    auto pending_copy=[&]{return copies.Overlaps(address,guest.size());};
+    CHECK(rescan.Pending(epoch,true,pending_copy));
+    copies.Add(2,pending); epoch.fetch_add(1,std::memory_order_release);
+    backing[8]=7;copies.Remove(1);epoch.fetch_add(1,std::memory_order_release);
+    CHECK(rescan.Pending(epoch,true,pending_copy)); // newer overlapping copy still owns bytes
+    CHECK(CoherentReadPointer(address,guest.size(),true,current,shared)==guest.data());
+    guest=backing; copies.Remove(2);epoch.fetch_add(1,std::memory_order_release);
+    CHECK(!rescan.Pending(epoch,true,pending_copy));
+    CHECK(CoherentReadPointer(address,guest.size(),true,current,shared)==backing.data());
+    CHECK(std::memcmp(guest.data(),backing.data(),guest.size())==0);
+    gpu_dirty=true;CHECK(CoherentReadPointer(address,guest.size(),true,current,shared)==guest.data());
+    CHECK(!lookup.Find(key,11)); // replacement invalidates image id even if same address
+    // A smaller transfer window still covers every byte of a cross-boundary request.
+    for(auto window:{64u*1024,512u*1024}) {
+        const auto [begin,end]=CalculateReadbackWindow(0x100000,0x400000,0x10fff8,32,window);
+        CHECK(begin<=0x10fff8 && end>=0x110018);
+    }
+}
diff --git a/tests/test_download_rescan.cpp b/tests/test_download_rescan.cpp
new file mode 100644
index 00000000..60d84acf
--- /dev/null
+++ b/tests/test_download_rescan.cpp
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <thread>
+#include <vector>
+#include "video_core/buffer_cache/download_rescan.h"
+#define CHECK(c) do { if (!(c)) { std::fprintf(stderr,"line %d: %s\n",__LINE__,#c); std::abort(); } } while(false)
+int main() {
+    using namespace VideoCore;
+    std::atomic<std::uint64_t> changes{0};
+    DownloadRescan scan;
+    int calls=0;
+    bool pending=true;
+    auto predicate=[&]{++calls;return pending;};
+    CHECK(scan.Pending(changes,true,predicate));
+    for(int i=0;i<1000;++i) CHECK(scan.Pending(changes,true,predicate));
+    CHECK(calls==1);
+    changes.fetch_add(1,std::memory_order_release); // unrelated completion, overlap remains
+    CHECK(scan.Pending(changes,true,predicate)); CHECK(calls==2);
+    changes.fetch_add(1,std::memory_order_release); // newer overlapping copy added
+    CHECK(scan.Pending(changes,true,predicate)); CHECK(calls==3);
+    pending=false; changes.fetch_add(1,std::memory_order_release);
+    CHECK(!scan.Pending(changes,true,predicate)); CHECK(calls==4);
+    DownloadRescan completed; CHECK(!completed.Pending(changes,true,predicate));
+    completed.Pending(changes,false,predicate); completed.Pending(changes,false,predicate);
+    CHECK(calls==7); // disabled always evaluates original predicate
+    // Completion in the locked predicate between epoch load and next poll is not lost.
+    DownloadRescan race; pending=true;
+    CHECK(race.Pending(changes,true,[&]{pending=false;changes.fetch_add(1,std::memory_order_release);return true;}));
+    CHECK(!race.Pending(changes,true,predicate));
+    // Callback publishes backing data before removing ownership; wait sees every overlapping copy.
+    for(int trial=0;trial<200;++trial) {
+        std::mutex mutex;
+        std::vector<int> downloads{1,2};
+        int backing=0;
+        std::atomic<std::uint64_t> epoch{};
+        std::thread writer([&]{
+            for(int id:{1,2}) {
+                std::scoped_lock lock{mutex};
+                backing+=id; downloads.pop_back();
+                epoch.fetch_add(1,std::memory_order_release);
+            }
+        });
+        DownloadRescan concurrent;
+        while(concurrent.Pending(epoch,true,[&]{std::scoped_lock lock{mutex};return !downloads.empty();})) std::this_thread::yield();
+        CHECK(backing==3); writer.join();
+    }
+}
diff --git a/tests/test_lookup_reuse.cpp b/tests/test_lookup_reuse.cpp
new file mode 100644
index 00000000..12f91d1c
--- /dev/null
+++ b/tests/test_lookup_reuse.cpp
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <cstdio>
+#include <cstdlib>
+#include "video_core/texture_cache/lookup_reuse.h"
+#define CHECK(c) do { if (!(c)) { std::fprintf(stderr,"line %d: %s\n",__LINE__,#c); std::abort(); } } while(false)
+struct Result { int id, mip, layer; };
+int main() {
+    using namespace VideoCore;
+    LookupReuseEntry<TextureLookupKey, Result> cache;
+    TextureLookupKey key{};
+    key.program = 7;
+    key.specialization = &cache;
+    CHECK(!cache.Find(key, 1));
+    cache.Store(key, 1, {42, 3, 2});
+    auto hit = cache.Find(key, 1);
+    CHECK(hit && hit->id == 42 && hit->mip == 3 && hit->layer == 2);
+    // Every descriptor word participates, including mip, layer, address and view format bits.
+    for (int i=0; i<8; ++i) { auto other=key; other.descriptor[i]^=1; CHECK(!cache.Find(other,1)); }
+    auto other=key; other.specialization=nullptr; CHECK(!cache.Find(other,1));
+    other=key; other.program++; CHECK(!cache.Find(other,1));
+    for (unsigned bit=0;bit<5;++bit) {other=key;other.resource_flags^=1u<<bit;CHECK(!cache.Find(other,1));}
+    other=key; other.mip_mode++; CHECK(!cache.Find(other,1));
+    other=key; other.mip_index++; CHECK(!cache.Find(other,1));
+    other=key; other.binding_index++; CHECK(!cache.Find(other,1));
+    other=key; other.alt_tile=true; CHECK(!cache.Find(other,1));
+    CHECK(!cache.Find(key,2)); // deletion/replacement, even if allocator reuses image id
+    cache.Store(key,2,{42,0,0});
+    CHECK(cache.Find(key,2)->mip==0);
+    cache.Invalidate(); CHECK(!cache.Find(key,2)); // needs_rebind
+    cache.Store(other,3,{17,6,4});
+    CHECK(!cache.Find(key,3)); CHECK(cache.Find(other,3)->layer==4);
+}
