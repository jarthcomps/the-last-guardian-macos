new file mode 100644
index 0000000..bae7446
--- /dev/null
+++ b/src/pkg_tool/byte_progress.h
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <cstdint>
+#include <functional>
+#include <stdexcept>
+#include <utility>
+
+using ByteProgressCallback = std::function<void(uint64_t written, uint64_t total)>;
+
+// One counter per package; called only after successful output writes.
+class ByteProgress {
+public:
+    ByteProgress(uint64_t total, ByteProgressCallback callback)
+        : total_(total), callback_(std::move(callback)) {
+        if (callback_) callback_(0, total_);
+    }
+    void Written(uint64_t bytes) {
+        if (bytes > total_ - written_) throw std::runtime_error("Invalid extracted byte count");
+        written_ += bytes;
+        if (callback_) callback_(written_, total_);
+    }
+private:
+    uint64_t total_, written_ = 0;
+    ByteProgressCallback callback_;
+};
