diff --git a/tests/byte_progress.cpp b/tests/byte_progress.cpp
new file mode 100644
index 0000000..174d36f
--- /dev/null
+++ b/tests/byte_progress.cpp
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "pkg_tool/byte_progress.h"
+#include <cstdlib>
+#include <iostream>
+#include <vector>
+
+void check(bool condition) {
+    if (!condition) { std::cerr << "Byte progress assertion failed\n"; std::exit(1); }
+}
+
+int main() {
+    // Two files, the first bigger than 4 GiB: callbacks must arrive within a file,
+    // accumulate across file boundaries, and count a short final decompression block exactly.
+    constexpr uint64_t big = uint64_t{5} << 30, tail = 17, total = big + tail;
+    std::vector<std::pair<uint64_t, uint64_t>> events;
+    ByteProgress progress(total, [&](auto done, auto size) { events.emplace_back(done, size); });
+    check(events.size() == 1 && events.back() == std::pair<uint64_t, uint64_t>(0, total));
+    progress.Written(65536);
+    check(events.back().first == 65536 && events.back().first < big);
+    progress.Written(big - 65536);
+    check(events.back().first == big);
+    progress.Written(tail);
+    check(events.back().first == total && events.back().second == total);
+    bool rejected = false;
+    try { progress.Written(1); } catch (const std::runtime_error&) { rejected = true; }
+    check(rejected && events.back().first == total);
+    ByteProgress update(100, [&](auto done, auto size) { events.emplace_back(done, size); });
+    check(events.back().first == 0 && events.back().second == 100);
+    ByteProgress empty(0, {});
+    empty.Written(0);
+    std::cout << "Byte progress tests passed\n";
+}
