new file mode 100644
index 00000000..bbbb2b61
--- /dev/null
+++ b/tests/test_backing_range.cpp
@@ -0,0 +1,43 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <cstdio>
+#include <limits>
+#include "core/backing_range.h"
+
+#define CHECK(condition) do { if (!(condition)) { \
+    std::fprintf(stderr, "Failed at line %d: %s\n", __LINE__, #condition); return 1; \
+} } while (false)
+
+int main() {
+    using Core::BackingRange;
+    using Core::ResolveBackingOffset;
+    constexpr auto Max = std::numeric_limits<std::uint64_t>::max();
+    const BackingRange first{0x100000000, 0x4000, 0x8000, true};
+    CHECK(ResolveBackingOffset(first, 0x10000, 0x100000020, 8) == 0x8020);
+    CHECK(ResolveBackingOffset(first, 0x10000, 0x100003ff8, 8) == 0xbff8);
+    CHECK(!ResolveBackingOffset(first, 0x10000, 0x100003ff8, 9));
+    CHECK(!ResolveBackingOffset(first, 0x10000, 0x0ffffffff, 8));
+    CHECK(!ResolveBackingOffset(first, 0x10000, 0x100004000, 1));
+    CHECK(!ResolveBackingOffset(first, 0x10000, 0x100000020, 0));
+    CHECK(!ResolveBackingOffset(first, 0x10000, 0x100000020, Max));
+    // Adjacent guest ranges may refer to completely different physical allocations.
+    const BackingRange next{0x100004000, 0x4000, 0, true};
+    CHECK(ResolveBackingOffset(next, 0x10000, 0x100004020, 8) == 0x20);
+    // macOS executable mappings are anonymous, even when VMA metadata lists physical areas.
+    CHECK(!ResolveBackingOffset({first.guest_base, first.size, first.physical_offset, false},
+                                0x10000, first.guest_base, 8));
+    CHECK(!ResolveBackingOffset({0x1000, 0x4000, 0x10000, true}, 0x10000, 0x1000, 8));
+    CHECK(!ResolveBackingOffset({0x1000, 0x4000, 0xfffc, true}, 0x10000, 0x1000, 8));
+    CHECK(!ResolveBackingOffset({0x1000, 0x4000, Max - 3, true}, Max, 0x1008, 1));
+    CHECK(!ResolveBackingOffset({Max - 7, 8, 0, true}, 0x10000, Max - 3, 8));
+    CHECK(ResolveBackingOffset({Max - 7, 8, 0, true}, 0x10000, Max - 3, 4) == 4);
+    // Host-side internal shader pointers must never index the 40-bit guest tracker.
+    constexpr std::uint64_t GuestLength = std::uint64_t{1} << 40;
+    CHECK(Core::ContainsBackingRequest(0, GuestLength, 0x32aaf0000, 8));
+    CHECK(!Core::ContainsBackingRequest(0, GuestLength, 0x7000019248ec, 8));
+    CHECK(Core::ContainsBackingRequest(0, GuestLength, GuestLength - 8, 8));
+    CHECK(!Core::ContainsBackingRequest(0, GuestLength, GuestLength - 8, 9));
+    CHECK(!Core::ContainsBackingRequest(0, GuestLength, Max - 7, 8));
+    return 0;
+}
diff --git a/tests/test_download_overlap.cpp b/tests/test_download_overlap.cpp
new file mode 100644
index 00000000..ede130e2
--- /dev/null
+++ b/tests/test_download_overlap.cpp
@@ -0,0 +1,54 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <array>
+#include <cstdio>
+#include <limits>
+#include "video_core/buffer_cache/download_overlap.h"
+
+#define CHECK(condition) do { if (!(condition)) { \
+    std::fprintf(stderr, "Failed at line %d: %s\n", __LINE__, #condition); return 1; \
+} } while (false)
+
+int main() {
+    using VideoCore::ReadbackCopiesOverlap;
+    using Range = std::pair<std::uintptr_t, std::uintptr_t>;
+    const std::array copies{Range{0x1800, 0x1900}, Range{0x1c00, 0x1c40}};
+    // A pending page-sized download does not change a shader header outside its actual copies.
+    CHECK(!ReadbackCopiesOverlap(copies, 0x1010, 8));
+    CHECK(ReadbackCopiesOverlap(copies, 0x1800, 8));
+    CHECK(ReadbackCopiesOverlap(copies, 0x17fc, 8));
+    CHECK(!ReadbackCopiesOverlap(copies, 0x17f8, 8));
+    CHECK(ReadbackCopiesOverlap(copies, 0x18ff, 1));
+    CHECK(!ReadbackCopiesOverlap(copies, 0x1900, 8));
+    CHECK(ReadbackCopiesOverlap(copies, 0x1c20, 8));
+    CHECK(!ReadbackCopiesOverlap(copies, 0x1c40, 8));
+    CHECK(ReadbackCopiesOverlap(copies, 0x1700, 0x600));
+    CHECK(!ReadbackCopiesOverlap(copies, 0x1800, 0));
+    CHECK(!ReadbackCopiesOverlap({}, 0x1800, 8));
+    const std::array invalid{Range{0x1900, 0x1800}, Range{0x1800, 0x1800}};
+    CHECK(!ReadbackCopiesOverlap(invalid, 0x1800, 8));
+    constexpr auto Max = std::numeric_limits<std::uint64_t>::max();
+    CHECK(!ReadbackCopiesOverlap(copies, Max - 3, 8));
+    VideoCore::PendingBackingCopies pending;
+    CHECK(!pending.Overlaps(0x1800, 8));
+    pending.Add(1, copies); // Ordinary asynchronous copy, with no deferred page unmark.
+    CHECK(pending.Overlaps(0x1800, 8));
+    CHECK(!pending.Overlaps(0x1010, 8));
+    pending.Add(2, copies); // A newer prefetch of the same bytes must keep them stale.
+    pending.Remove(1);
+    CHECK(pending.Overlaps(0x1800, 8));
+    pending.Remove(999);
+    CHECK(pending.Overlaps(0x1800, 8));
+    pending.Remove(2);
+    CHECK(!pending.Overlaps(0x1800, 8));
+    // Copy metadata must survive the caller reusing its temporary list.
+    std::array temporary{Range{0x2000, 0x2010}};
+    pending.Add(3, temporary);
+    temporary[0] = Range{0x3000, 0x3010};
+    CHECK(pending.Overlaps(0x2000, 8));
+    CHECK(!pending.Overlaps(0x3000, 8));
+    pending.Remove(3);
+    CHECK(!pending.Overlaps(0x2000, 8));
+    return 0;
+}
