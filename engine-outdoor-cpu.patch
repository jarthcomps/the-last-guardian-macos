new file mode 100644
index 00000000..5c290a68
--- /dev/null
+++ b/tests/test_compute_dispatch_labels.cpp
@@ -0,0 +1,49 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <cassert>
+#include <cstdlib>
+#include <string>
+#include <unordered_map>
+#include <vector>
+#include "video_core/renderer_vulkan/compute_dispatch_labels.h"
+VULKAN_HPP_DEFAULT_DISPATCH_LOADER_DYNAMIC_STORAGE
+void assert_fail_impl() { std::abort(); }
+namespace Common { std::string GetCurrentThreadName() { return "compute-label-test"; } }
+namespace Common::Log { std::unordered_map<std::string_view, std::shared_ptr<spdlog::logger>> ALL_LOGGERS; }
+namespace {
+std::vector<std::string> events;
+VKAPI_ATTR void VKAPI_CALL Begin(VkCommandBuffer, const VkDebugUtilsLabelEXT* l) { events.push_back(l->pLabelName); }
+VKAPI_ATTR void VKAPI_CALL End(VkCommandBuffer) { events.push_back("end"); }
+VKAPI_ATTR void VKAPI_CALL Dispatch(VkCommandBuffer, uint32_t x, uint32_t y, uint32_t z) {
+    assert(x == 3 && y == 4 && z == 5); events.push_back("dispatch");
+}
+}
+int main(int argc, char**) {
+    using namespace Vulkan;
+    using namespace ComputeDiagnostic;
+    if (argc > 1) { unsetenv("SHADPS4_COMPUTE_DISPATCH_LABELS"); assert(!Enabled()); return 0; }
+    setenv("SHADPS4_COMPUTE_DISPATCH_LABELS", "1", 1); assert(Enabled());
+    auto& d = vk::detail::defaultDispatchLoaderDynamic;
+    d.vkCmdBeginDebugUtilsLabelEXT = Begin; d.vkCmdEndDebugUtilsLabelEXT = End;
+    d.vkCmdDispatch = Dispatch;
+    const auto label = GuestLabel(0x123, false, {3,4,5}, {64,1,1});
+    assert(label == "guest_cs_0000000000000123 direct groups=3x4x5 local=64x1x1");
+    const auto indirect = GuestLabel(~uint64_t{}, true, {0,0,0}, {32,2,1});
+    assert(indirect.find("indirect") != std::string::npos);
+    assert(TilingLabel(false, 2, 32, 4, 3, 70) == "host_detiler mode=2 bits=32 mips=4 slices=3 groups=70");
+    assert(TilingLabel(true, 2, 32, 1, 1, 70).starts_with("host_tiler "));
+    const vk::CommandBuffer cb{reinterpret_cast<VkCommandBuffer>(1)};
+    CommandList list;
+    CommandRecorder r{cb, &list};
+    { std::string ephemeral = label; Scope scope{r, ephemeral}; r.dispatch(3,4,5); ephemeral = "changed"; }
+    assert(events.empty() && list.Size() == 3);
+    list.Replay(cb); assert((events == std::vector<std::string>{label, "dispatch", "end"}));
+    events.clear(); { Scope disabled{r, ""}; r.dispatch(3,4,5); }
+    list.Replay(cb); assert((events == std::vector<std::string>{"dispatch"}));
+    events.clear(); { Scope direct{CommandRecorder{cb}, label}; CommandRecorder{cb}.dispatch(3,4,5); }
+    assert((events == std::vector<std::string>{label, "dispatch", "end"}));
+    events.clear(); d.vkCmdBeginDebugUtilsLabelEXT = nullptr;
+    { Scope unsupported{r, label}; r.dispatch(3,4,5); }
+    list.Replay(cb); assert((events == std::vector<std::string>{"dispatch"}));
+    return 0;
+}
diff --git a/tests/test_dynamic_state_reuse.cpp b/tests/test_dynamic_state_reuse.cpp
new file mode 100644
index 00000000..54cfc33a
--- /dev/null
+++ b/tests/test_dynamic_state_reuse.cpp
@@ -0,0 +1,99 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <array>
+#include <bit>
+#include <cassert>
+#include <cstdlib>
+#include <string>
+#include <unordered_map>
+#include <vector>
+#include "video_core/renderer_vulkan/vk_command_recorder.h"
+VULKAN_HPP_DEFAULT_DISPATCH_LOADER_DYNAMIC_STORAGE
+void assert_fail_impl() { std::abort(); }
+namespace Common { std::string GetCurrentThreadName() { return "dynamic-state-test"; } }
+namespace Common::Log { std::unordered_map<std::string_view, std::shared_ptr<spdlog::logger>> ALL_LOGGERS; }
+namespace {
+std::vector<float> widths;
+unsigned state_calls{}, viewport_calls{}, scissor_calls{}, pipeline_calls{}, render_calls{};
+VKAPI_ATTR void VKAPI_CALL Width(VkCommandBuffer, float v) { widths.push_back(v); }
+VKAPI_ATTR void VKAPI_CALL Depth(VkCommandBuffer, VkBool32) { ++state_calls; }
+VKAPI_ATTR void VKAPI_CALL Viewports(VkCommandBuffer, uint32_t, uint32_t, const VkViewport*) { ++viewport_calls; }
+VKAPI_ATTR void VKAPI_CALL CountedViewports(VkCommandBuffer, uint32_t, const VkViewport*) { ++viewport_calls; }
+VKAPI_ATTR void VKAPI_CALL Scissors(VkCommandBuffer, uint32_t, uint32_t, const VkRect2D*) { ++scissor_calls; }
+VKAPI_ATTR void VKAPI_CALL Pipeline(VkCommandBuffer, VkPipelineBindPoint, VkPipeline) { ++pipeline_calls; }
+VKAPI_ATTR void VKAPI_CALL Begin(VkCommandBuffer, const VkRenderingInfo*) { ++render_calls; }
+VKAPI_ATTR void VKAPI_CALL End(VkCommandBuffer) { ++render_calls; }
+}
+int main() {
+    auto& d = vk::detail::defaultDispatchLoaderDynamic;
+    d.vkCmdSetLineWidth = Width; d.vkCmdSetDepthTestEnable = Depth;
+    d.vkCmdSetViewport = Viewports; d.vkCmdSetViewportWithCount = CountedViewports;
+    d.vkCmdSetScissor = Scissors; d.vkCmdBindPipeline = Pipeline;
+    d.vkCmdBeginRendering = Begin; d.vkCmdEndRendering = End;
+    const vk::CommandBuffer cb{reinterpret_cast<VkCommandBuffer>(1)};
+    unsetenv("SHADPS4_DYNAMIC_STATE_REUSE");
+    Vulkan::CommandList baseline;
+    Vulkan::CommandRecorder disabled{cb, &baseline};
+    disabled.setLineWidth(1); disabled.setLineWidth(1);
+    assert(baseline.Size() == 2); baseline.Replay(cb);
+    setenv("SHADPS4_DYNAMIC_STATE_REUSE", "1", 1);
+    Vulkan::CommandList list;
+    Vulkan::CommandRecorder r{cb, &list};
+    r.setLineWidth(1); r.setLineWidth(1); r.setLineWidth(2); r.setLineWidth(1);
+    assert(list.Size() == 3);
+    r.setDepthTestEnable(true); r.setDepthTestEnable(true);
+    assert(list.Size() == 4);
+    std::array<vk::Viewport, 2> v{vk::Viewport{0,0,100,100,0,1}, vk::Viewport{1,1,90,90,0,1}};
+    r.setViewport(0, v); r.setViewport(0, v);
+    assert(list.Size() == 5);
+    r.setViewport(1, vk::ArrayProxy<const vk::Viewport>{1, v.data()});
+    r.setViewport(0, v);
+    r.setViewportWithCount(v); r.setViewportWithCount(v); r.setViewport(0, v);
+    assert(list.Size() == 9);
+    r.setScissor(0, vk::Rect2D{{0,0},{100,100}});
+    r.setScissor(0, vk::Rect2D{{0,0},{100,100}});
+    assert(list.Size() == 10);
+    v[0].width = 999; // The queued viewport owns the original array.
+    list.Replay(cb);
+    assert(viewport_calls == 5 && scissor_calls == 1 && state_calls == 1);
+    r.setLineWidth(1); assert(list.Size() == 1);
+    r.bindPipeline(vk::PipelineBindPoint::eGraphics, vk::Pipeline{reinterpret_cast<VkPipeline>(2)});
+    r.setLineWidth(1); assert(list.Size() == 3);
+    r.bindPipeline(vk::PipelineBindPoint::eGraphics, vk::Pipeline{reinterpret_cast<VkPipeline>(2)});
+    r.setLineWidth(1); assert(list.Size() == 3);
+    r.beginRendering(vk::RenderingInfo{}); r.setLineWidth(1);
+    r.endRendering(); r.setLineWidth(1);
+    assert(list.Size() == 7); list.Replay(cb);
+    assert(pipeline_calls == 1 && render_calls == 2);
+    Vulkan::CommandList other;
+    Vulkan::CommandRecorder{cb, &other}.setLineWidth(1);
+    assert(other.Size() == 1);
+    const auto before = widths.size();
+    Vulkan::CommandRecorder{cb}.setLineWidth(1); Vulkan::CommandRecorder{cb}.setLineWidth(1);
+    assert(widths.size() == before + 2);
+
+    Vulkan::DynamicStateReuse memo;
+    using K = Vulkan::DynamicStateReuse::Key;
+    std::array<unsigned, 5> faces{1,2,3,4,5};
+    assert(memo.ShouldRecord(K::StencilOp, 0, 0, 1, faces.data(), sizeof(faces)));
+    assert(!memo.ShouldRecord(K::StencilOp, 0, 0, 1, faces.data(), sizeof(faces)));
+    faces[0] = 2;
+    assert(memo.ShouldRecord(K::StencilOp, 0, 0, 1, faces.data(), sizeof(faces)));
+    faces[0] = 1;
+    assert(memo.ShouldRecord(K::StencilOp, 0, 0, 1, faces.data(), sizeof(faces)));
+    for (size_t key = 0; key < static_cast<size_t>(K::Count); ++key) {
+        auto k = static_cast<K>(key);
+        memo.Reset(); unsigned value = 0;
+        assert(memo.ShouldRecord(k, 0, 0, 1, &value, sizeof(value)));
+        assert(!memo.ShouldRecord(k, 0, 0, 1, &value, sizeof(value)));
+        ++value; assert(memo.ShouldRecord(k, 0, 0, 1, &value, sizeof(value)));
+        memo.Reset(); assert(memo.ShouldRecord(k, 0, 0, 1, &value, sizeof(value)));
+    }
+    const unsigned minus_zero = 0x80000000, plus_zero = 0;
+    assert(memo.ShouldRecord(K::LineWidth, 0, 0, 1, &plus_zero, 4));
+    assert(memo.ShouldRecord(K::LineWidth, 0, 0, 1, &minus_zero, 4));
+    std::array<unsigned char, 513> large{};
+    assert(memo.ShouldRecord(K::Viewport, 0, 0, 1, large.data(), large.size()));
+    assert(memo.ShouldRecord(K::Viewport, 0, 0, 1, large.data(), large.size()));
+    return 0;
+}
diff --git a/tests/test_range_protection.cpp b/tests/test_range_protection.cpp
new file mode 100644
index 00000000..fc897e61
--- /dev/null
+++ b/tests/test_range_protection.cpp
@@ -0,0 +1,71 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <array>
+#include <cassert>
+#include <random>
+#include <vector>
+#include "video_core/buffer_cache/region_manager.h"
+namespace {
+struct Event { bool track; VideoCore::RegionBits mask; bool operator==(const Event&) const = default; };
+std::vector<Event> events;
+}
+namespace VideoCore {
+struct PageManager::Impl {};
+PageManager::PageManager(Vulkan::Rasterizer*) : impl{std::make_unique<Impl>()} {}
+PageManager::~PageManager() = default;
+template <> void PageManager::UpdatePageWatchersForRegion<true, false>(VAddr, RegionBits& mask) const { events.push_back({true, mask}); }
+template <> void PageManager::UpdatePageWatchersForRegion<false, false>(VAddr, RegionBits& mask) const { events.push_back({false, mask}); }
+}
+int main() {
+    using namespace VideoCore;
+    std::mt19937 random(41);
+    RegionBits a, b;
+    for (unsigned i = 0; i < NUM_PAGES_PER_REGION; ++i) {
+        if (random() & 1) a.Set(i);
+        if (random() & 1) b.Set(i);
+    }
+    for (size_t start = 0; start <= NUM_PAGES_PER_REGION; ++start) {
+        for (size_t length : {0u, 1u, 2u, 63u, 64u, 65u, 1024u}) {
+            const auto end = std::min(start + length, size_t(NUM_PAGES_PER_REGION));
+            auto updated = a;
+            const RegionBits expected(a ^ b, start, end);
+            assert(updated.AssignRange(b, start, end) == expected);
+            assert(updated == (a ^ expected));
+            assert(updated.AssignRange(b, start, end).None());
+        }
+    }
+    assert(a.AssignRange(b, 5, 4).None());
+    assert(a.AssignRange(b, 0, NUM_PAGES_PER_REGION + 1).None());
+    PageManager tracker{nullptr};
+    constexpr VAddr base = 0x10000000;
+    RegionManager baseline{&tracker, base}, candidate{&tracker, base};
+    candidate.SetRangeProtectionEnabled(true);
+    baseline.SetHotPagesEnabled(true); candidate.SetHotPagesEnabled(true);
+    baseline.GetRegionBits<Type::GPU>().Set(64);
+    candidate.GetRegionBits<Type::GPU>().Set(64);
+    auto mutate = [&](RegionManager& m, unsigned op, size_t first, size_t count) {
+        const auto address = base + first * TRACKER_BYTES_PER_PAGE + 1;
+        const auto bytes = count * TRACKER_BYTES_PER_PAGE - 2;
+        switch (op) {
+        case 0: m.NoteCpuWrite(address, bytes);
+                m.ChangeRegionState<Type::CPU, true>(address, bytes); break;
+        case 1: m.ChangeRegionState<Type::CPU, false>(address, bytes); break;
+        case 2: m.ForEachModifiedRange<Type::CPU, true>(address, bytes, [](VAddr, u64){}, true); break;
+        case 3: m.ForEachModifiedRange<Type::CPU, true>(address, bytes, [](VAddr, u64){}, false); break;
+        case 4: m.DecayHotPages(); break;
+        }
+    };
+    for (unsigned i = 0; i < 6000; ++i) {
+        const size_t first = random() % NUM_PAGES_PER_REGION;
+        const size_t count = std::min<size_t>(1 + random() % 130, NUM_PAGES_PER_REGION - first);
+        const unsigned op = random() % 5;
+        events.clear(); mutate(baseline, op, first, count); const auto expected = events;
+        events.clear(); mutate(candidate, op, first, count); assert(events == expected);
+        assert(baseline.GetRegionBits<Type::CPU>() == candidate.GetRegionBits<Type::CPU>());
+        assert(baseline.GetRegionBits<Type::GPU>() == candidate.GetRegionBits<Type::GPU>());
+    }
+    // Repeated invalidation of an already writable page must emit no new protection request.
+    mutate(candidate, 0, 63, 2); events.clear(); mutate(candidate, 0, 63, 2);
+    assert(events.empty());
+    return 0;
+}
diff --git a/tests/test_upload_cache_policy.c b/tests/test_upload_cache_policy.c
new file mode 100644
index 00000000..513449ad
--- /dev/null
+++ b/tests/test_upload_cache_policy.c
@@ -0,0 +1,24 @@
+#include <assert.h>
+#include "kk_upload_cache_policy.h"
+int main(void) {
+   assert(!kk_upload_cache_enabled(0));
+   assert(!kk_upload_cache_enabled("0"));
+   assert(!kk_upload_cache_enabled("10"));
+   assert(kk_upload_cache_enabled("1"));
+   for (unsigned expanded = 0; expanded < 2; ++expanded) {
+      unsigned cached = 0, destroyed = 0;
+      for (unsigned completed = 0; completed < 300; ++completed) {
+         if (kk_upload_cache_keep(cached, expanded)) ++cached;
+         else ++destroyed;
+      }
+      assert(cached == (expanded ? 128 : 33));
+      assert(cached + destroyed == 300);
+      while (cached) --cached;
+      assert(kk_upload_cache_keep(cached, expanded));
+   }
+   assert(kk_upload_cache_keep(32, false));
+   assert(!kk_upload_cache_keep(33, false));
+   assert(kk_upload_cache_keep(127, true));
+   assert(!kk_upload_cache_keep(128, true));
+   return 0;
+}
