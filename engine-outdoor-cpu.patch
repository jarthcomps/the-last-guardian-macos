+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <string_view>
+#include "video_core/renderer_vulkan/vk_command_recorder.h"
+
+namespace Vulkan::ComputeDiagnostic {
+inline bool Enabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("SHADPS4_COMPUTE_DISPATCH_LABELS");
+        return value && std::string_view{value} == "1";
+    }();
+    return enabled;
+}
+inline std::string GuestLabel(uint64_t hash, bool indirect, std::array<u32, 3> groups,
+                              std::array<u32, 3> local) {
+    char text[192];
+    std::snprintf(text, sizeof(text),
+                  "guest_cs_%016llx %s groups=%ux%ux%u local=%ux%ux%u",
+                  static_cast<unsigned long long>(hash), indirect ? "indirect" : "direct",
+                  groups[0], groups[1], groups[2], local[0], local[1], local[2]);
+    return text;
+}
+inline std::string TilingLabel(bool tiler, u32 mode, u32 bits, u32 mips, u32 slices, u32 groups) {
+    char text[192];
+    std::snprintf(text, sizeof(text), "host_%s mode=%u bits=%u mips=%u slices=%u groups=%u",
+                  tiler ? "tiler" : "detiler", mode, bits, mips, slices, groups);
+    return text;
+}
+class Scope {
+public:
+    Scope(CommandRecorder recorder_, const std::string& label) : recorder{recorder_} {
+        active = !label.empty() &&
+                 vk::detail::defaultDispatchLoaderDynamic.vkCmdBeginDebugUtilsLabelEXT &&
+                 vk::detail::defaultDispatchLoaderDynamic.vkCmdEndDebugUtilsLabelEXT;
+        if (active) recorder.beginDebugUtilsLabelEXT(vk::DebugUtilsLabelEXT{.pLabelName = label.c_str()});
+    }
+    ~Scope() { if (active) recorder.endDebugUtilsLabelEXT(); }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+private:
+    CommandRecorder recorder;
+    bool active{};
+};
+} // namespace Vulkan::ComputeDiagnostic
diff --git a/src/video_core/renderer_vulkan/dynamic_state_reuse.h b/src/video_core/renderer_vulkan/dynamic_state_reuse.h
new file mode 100644
index 00000000..55ef0cf7
--- /dev/null
+++ b/src/video_core/renderer_vulkan/dynamic_state_reuse.h
@@ -0,0 +1,53 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace Vulkan {
+class DynamicStateReuse {
+public:
+    enum class Key : size_t {
+        Viewport, Scissor, DepthTest, DepthWrite, DepthCompare, DepthBoundsTest,
+        DepthBounds, DepthBiasEnable, DepthBias, StencilTest, StencilOp,
+        StencilReference, StencilWriteMask, StencilCompareMask, PrimitiveRestart,
+        RasterizerDiscard, Cull, FrontFace, LineWidth, BlendConstants, ColorWriteMask,
+        FeedbackLoop, Count
+    };
+    // A single entry per state is conservative for partial/overlapping array and face updates:
+    // only an exact repeat of the last setter can be suppressed.
+    bool ShouldRecord(Key key, uint32_t variant, uint32_t first, uint32_t count,
+                      const void* values, size_t size) {
+        auto& entry = entries[static_cast<size_t>(key)];
+        if (!values || size == 0 || size > entry.bytes.size()) {
+            entry.valid = false;
+            return true;
+        }
+        if (entry.valid && entry.variant == variant && entry.first == first &&
+            entry.count == count && entry.size == size &&
+            std::memcmp(entry.bytes.data(), values, size) == 0) {
+            return false;
+        }
+        entry.valid = true;
+        entry.variant = variant;
+        entry.first = first;
+        entry.count = count;
+        entry.size = size;
+        std::memcpy(entry.bytes.data(), values, size);
+        return true;
+    }
+    void Reset() {
+        for (auto& entry : entries) entry.valid = false;
+    }
+private:
+    struct Entry {
+        std::array<std::byte, 512> bytes{};
+        size_t size{};
+        uint32_t variant{}, first{}, count{};
+        bool valid{};
+    };
+    std::array<Entry, static_cast<size_t>(Key::Count)> entries{};
+};
+} // namespace Vulkan
