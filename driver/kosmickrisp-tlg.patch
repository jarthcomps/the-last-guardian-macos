diff --git a/src/kosmickrisp/vulkan/test_shadps4_encoder_stats.c b/src/kosmickrisp/vulkan/test_shadps4_encoder_stats.c
new file mode 100644
index 0000000..c49f2e0
--- /dev/null
+++ b/src/kosmickrisp/vulkan/test_shadps4_encoder_stats.c
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: MIT */
+#include "shadps4_encoder_stats.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+static int failures;
+
+static void
+check(bool condition, const char *what)
+{
+   if (!condition) {
+      fprintf(stderr, "Encoder stats test failed: %s\n", what);
+      failures++;
+   }
+}
+
+int
+main(void)
+{
+   struct kk_shadps4_encoder_stats before = {0};
+   struct kk_shadps4_encoder_stats after = {0};
+   before.command_buffers = 10;
+   after.command_buffers = 940;
+   after.render_starts[KK_SHADPS4_RENDER_START_BEGIN] = 2960;
+   after.render_starts[KK_SHADPS4_RENDER_START_BARRIER] = 1200;
+   after.render_starts[KK_SHADPS4_RENDER_START_COMPUTE] = 840;
+   before.render_starts[KK_SHADPS4_RENDER_START_COMPUTE] = 40;
+   after.render_starts[KK_SHADPS4_RENDER_START_STATE] = 3;
+   after.compute_after_render = 4000;
+   after.compute_fresh = 6000;
+   before.compute_fresh = 1;
+   after.end_rendering_closed_compute = 4700;
+   after.end_rendering_empty = 2;
+   after.barriers_in_render = 1500;
+   after.barriers_in_render_split = 1200;
+   after.draws = 27000;
+   after.dispatches = 15000;
+   after.unroll_restart = 52;
+   after.unroll_flatshade = 1;
+   after.compute_barriers = 900;
+   before.compute_barriers = 100;
+   after.compute_barriers_idle = 70;
+
+   const struct kk_shadps4_encoder_stats d = kk_shadps4_encoder_stats_delta(&before, &after);
+   check(d.command_buffers == 930, "command buffer delta");
+   check(d.render_starts[KK_SHADPS4_RENDER_START_COMPUTE] == 800, "render start delta by reason");
+   check(d.compute_fresh == 5999, "compute fresh delta");
+   check(kk_shadps4_encoder_stats_render_starts(&d) == 2960 + 1200 + 800 + 3,
+         "render start total");
+
+   check(kk_shadps4_env_flag("1"), "switch on");
+   check(!kk_shadps4_env_flag(NULL) && !kk_shadps4_env_flag("0") &&
+            !kk_shadps4_env_flag("") && !kk_shadps4_env_flag("10"),
+         "switch off");
+   uint64_t last = 0;
+   check(!kk_shadps4_compute_barrier_idle(&last, 5), "barrier after dispatches");
+   check(kk_shadps4_compute_barrier_idle(&last, 5), "barrier right after a barrier");
+   check(!kk_shadps4_compute_barrier_idle(&last, 6), "barrier after one more dispatch");
+
+   char line[512];
+   const int n = kk_shadps4_encoder_stats_format(&d, 1.0, line, sizeof(line));
+   check(n > 0 && (size_t)n < sizeof(line), "line fits");
+   check(strcmp(line,
+                "KK_ENCODER_STATS dt=1.00s cmdbufs=930 render_enc=4963 begin=2960 "
+                "barrier=1200 after_compute=800 state=3 compute_enc=9999 "
+                "after_render=4000 fresh=5999 end_rendering_closed_compute=4700 "
+                "end_rendering_empty=2 barriers_in_render=1500 split=1200 draws=27000 "
+                "dispatches=15000 unroll_fan=0 unroll_promotion=0 unroll_robustness=0 "
+                "unroll_restart=52 unroll_flatshade=1 compute_barriers=800 "
+                "compute_barriers_idle=70\n") == 0,
+         "report line");
+
+   /* A zero interval formats cleanly too. */
+   const struct kk_shadps4_encoder_stats zero = {0};
+   check(kk_shadps4_encoder_stats_format(&zero, 0.5, line, sizeof(line)) > 0, "zero line");
+   check(strstr(line, "cmdbufs=0 render_enc=0 ") != NULL, "zero counts");
+
+   /* Truncation reports the needed size without overflowing. */
+   char small[16];
+   const int needed = kk_shadps4_encoder_stats_format(&d, 1.0, small, sizeof(small));
+   check(needed == n, "needed length");
+   check(small[sizeof(small) - 1] == '\0', "terminated when truncated");
+
+   if (failures) {
+      fprintf(stderr, "%d encoder stats checks failed\n", failures);
+      return EXIT_FAILURE;
+   }
+   puts("Encoder stats tests passed");
+   return EXIT_SUCCESS;
+}
diff --git a/src/kosmickrisp/vulkan/test_shadps4_flush_state.c b/src/kosmickrisp/vulkan/test_shadps4_flush_state.c
new file mode 100644
index 0000000..d211ded
--- /dev/null
+++ b/src/kosmickrisp/vulkan/test_shadps4_flush_state.c
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: MIT */
+#include "shadps4_flush_state.h"
+
+#include <stdio.h>
+#include <string.h>
+
+static int failures;
+
+static void
+check(bool condition, const char *what)
+{
+   if (!condition) {
+      fprintf(stderr, "Flush state test failed: %s\n", what);
+      failures++;
+   }
+}
+
+int
+main(void)
+{
+   /* Vertex buffer rebinds */
+   check(!kk_shadps4_vb_binding_changed(0x1000, 256, 0x1000, 256),
+         "same address and size: no change");
+   check(kk_shadps4_vb_binding_changed(0x1000, 256, 0x2000, 256),
+         "address moved: change");
+   check(kk_shadps4_vb_binding_changed(0x1000, 256, 0x1000, 512),
+         "size changed: change");
+   check(!kk_shadps4_vb_binding_changed(0, 0, 0, 0),
+         "null binding rebound as null: no change");
+   check(kk_shadps4_vb_binding_changed(0, 0, 0x1000, 0),
+         "null binding bound: change");
+
+   /* Argument table root slot */
+   check(kk_shadps4_root_bind_needed(0, 0x5000),
+         "slot unknown (after reset): write");
+   check(!kk_shadps4_root_bind_needed(0x5000, 0x5000),
+         "slot already holds the root: no write");
+   check(kk_shadps4_root_bind_needed(0x5000, 0x6000),
+         "slot holds another root: write");
+   check(kk_shadps4_root_bind_needed(0, 0), "zero address: always written");
+   check(kk_shadps4_root_bind_needed(0x5000, 0),
+         "zero address over a root: written");
+
+   /* Push descriptor upload reuse */
+   uint8_t uploaded[8] = {1, 2, 3, 4, 5, 6, 7, 8};
+   uint8_t same[8] = {1, 2, 3, 4, 5, 6, 7, 8};
+   uint8_t last_differs[8] = {1, 2, 3, 4, 5, 6, 7, 9};
+   check(!kk_shadps4_push_upload_reusable(false, uploaded, same, 8),
+         "never uploaded: upload");
+   check(!kk_shadps4_push_upload_reusable(true, NULL, same, 8),
+         "no upload pointer: upload");
+   check(kk_shadps4_push_upload_reusable(true, uploaded, same, 8),
+         "same bytes as the last upload: reuse");
+   check(!kk_shadps4_push_upload_reusable(true, uploaded, last_differs, 8),
+         "last byte differs: upload");
+   check(!kk_shadps4_push_upload_reusable(true, uploaded, same, 0),
+         "empty size: upload");
+
+   /* Graphics shader rebinds */
+   int shader_a = 1, shader_b = 2;
+   check(!kk_shadps4_shader_rebind_needed(&shader_a, &shader_a),
+         "same shader on the stage: no rebind");
+   check(kk_shadps4_shader_rebind_needed(&shader_a, &shader_b),
+         "other shader: rebind");
+   check(kk_shadps4_shader_rebind_needed(NULL, &shader_a),
+         "shader on an empty stage: rebind");
+   check(kk_shadps4_shader_rebind_needed(&shader_a, NULL),
+         "empty stage over a shader: rebind");
+   check(!kk_shadps4_shader_rebind_needed(NULL, NULL),
+         "empty stage stays empty: no rebind");
+
+   /* Copy only when changed */
+   uint8_t dst[4] = {1, 2, 3, 4};
+   const uint8_t identical[4] = {1, 2, 3, 4};
+   const uint8_t changed[4] = {1, 9, 3, 4};
+   check(!kk_shadps4_copy_if_changed(dst, identical, 4),
+         "identical bytes: no copy reported");
+   check(kk_shadps4_copy_if_changed(dst, changed, 4),
+         "changed bytes: copy reported");
+   check(memcmp(dst, changed, sizeof(dst)) == 0,
+         "changed bytes: destination holds the new bytes");
+   check(!kk_shadps4_copy_if_changed(dst, changed, 0),
+         "empty copy: no change");
+
+   if (failures)
+      return 1;
+   printf("shadps4 flush state: all checks passed\n");
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/test_shadps4_msl_override.c b/src/kosmickrisp/vulkan/test_shadps4_msl_override.c
new file mode 100644
index 0000000..aca60b6
--- /dev/null
+++ b/src/kosmickrisp/vulkan/test_shadps4_msl_override.c
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: MIT */
+#include "shadps4_msl_override.h"
+
+#include <unistd.h>
+
+static int failures;
+
+static void
+check(bool condition, const char *what)
+{
+   if (!condition) {
+      fprintf(stderr, "MSL override test failed: %s\n", what);
+      failures++;
+   }
+}
+
+int
+main(void)
+{
+   char *r = kk_shadps4_replace_all("a main_ep b main_ep", "main_ep", "X");
+   check(r && strcmp(r, "a X b X") == 0, "replace all occurrences");
+   free(r);
+
+   const char *plain = "kernel void main_entrypoint(device int* p) { p[0] = 1; }";
+   const char *named = "kernel void shadps4_guest_Compute_1171c360(device int* p) { p[0] = 1; }";
+   uint64_t k1 = 0, k2 = 0;
+   char *n1 = kk_shadps4_msl_normalize(plain, "main_entrypoint", &k1);
+   char *n2 = kk_shadps4_msl_normalize(named, "shadps4_guest_Compute_1171c360", &k2);
+   check(k1 == k2 && k1 != 0, "same key whatever the entry point is called");
+   check(strstr(n1, KK_SHADPS4_ENTRY_PLACEHOLDER) != NULL, "placeholder in normalized text");
+   free(n1);
+   free(n2);
+
+   char path[256];
+   kk_shadps4_msl_path(path, sizeof(path), "/tmp/x", 0xabcull, "metal");
+   check(strcmp(path, "/tmp/x/0000000000000abc.metal") == 0, "path format");
+
+   /* Dump then override through the environment. */
+   char dir[] = "/tmp/kk_msl_testXXXXXX";
+   check(mkdtemp(dir) != NULL, "temp dir");
+   setenv("KK_SHADPS4_MSL_DUMP_DIR", dir, 1);
+   bool owned = true;
+   const char *src = kk_shadps4_msl_source(plain, "main_entrypoint", "compute", &owned);
+   check(src == plain && !owned, "no override yet: generated source");
+   kk_shadps4_msl_path(path, sizeof(path), dir, k1, "metal");
+   char *dumped = kk_shadps4_read_file(path);
+   check(dumped && strstr(dumped, KK_SHADPS4_ENTRY_PLACEHOLDER), "dumped with placeholder");
+   free(dumped);
+   unsetenv("KK_SHADPS4_MSL_DUMP_DIR");
+
+   FILE *f = fopen(path, "wb");
+   fputs("kernel void " KK_SHADPS4_ENTRY_PLACEHOLDER "(device int* p) { p[0] = 2; }", f);
+   fclose(f);
+   setenv("KK_SHADPS4_MSL_OVERRIDE_DIR", dir, 1);
+   src = kk_shadps4_msl_source(named, "shadps4_guest_Compute_1171c360", "compute", &owned);
+   check(owned && strstr(src, "shadps4_guest_Compute_1171c360(device int* p) { p[0] = 2; }"),
+         "override with the real entry point name");
+   if (owned)
+      free((void *)src);
+   src = kk_shadps4_msl_source("kernel void other() {}", "other", "compute", &owned);
+   check(!owned, "other shaders unchanged");
+   unsetenv("KK_SHADPS4_MSL_OVERRIDE_DIR");
+   remove(path);
+   kk_shadps4_msl_path(path, sizeof(path), dir, k1, "txt");
+   remove(path);
+   rmdir(dir);
+   return failures ? 1 : 0;
+}
diff --git a/src/kosmickrisp/vulkan/test_shadps4_msl_recipe.c b/src/kosmickrisp/vulkan/test_shadps4_msl_recipe.c
new file mode 100644
index 0000000..4bfa0a1
--- /dev/null
+++ b/src/kosmickrisp/vulkan/test_shadps4_msl_recipe.c
@@ -0,0 +1,185 @@
+/* SPDX-License-Identifier: MIT */
+#include "shadps4_msl_override.h"
+
+#include <unistd.h>
+
+static int failures;
+
+static void
+check(bool condition, const char *what)
+{
+   if (!condition) {
+      fprintf(stderr, "MSL recipe test failed: %s\n", what);
+      failures++;
+   }
+}
+
+/* A synthetic shader in the shape the driver generates (no game code). */
+static const char *const kernel_src =
+   "#include <metal_stdlib>\n"
+   "using namespace metal;\n"
+   "kernel void KK_SHADPS4_ENTRY(\n"
+   "    constant Buffer &buf0 [[buffer(0)]]\n"
+   ")\n"
+   "{\n"
+   "    t7 = *(constant ulong*)(t6);\n"
+   "    t8 = uint4(*(coherent device packed_uint4*)(t7 + uint(0u)));\n"
+   "    t9 = t8.z;\n"
+   "    if (t10) {\n"
+   "        t11 = *(coherent device float*)(t12);\n"
+   "        r1 = as_type<uint>((t11));\n"
+   "    } else {\n"
+   "        r1 = as_type<uint>(float(0.0));\n"
+   "    }\n"
+   "    if (t13) {\n"
+   "        t14 = uint4(*(coherent device packed_uint4*)(t7 + uint(16u)));\n"
+   "        r2 = t14.x;\n"
+   "    } else {\n"
+   "        r2 = uint(0u);\n"
+   "    }\n"
+   "    t15 = !&buf0.contents[0] ? 1 : t9 * t9;\n"
+   "    (*(coherent device uint*)t12) = r1;\n"
+   "}\n";
+
+static void
+test_steps(void)
+{
+   char *out = kk_shadps4_recipe_apply(kernel_src, "const-loads");
+   check(out && strstr(out, "t11 = *(const device float*)(t12);"), "const-loads rewrites loads");
+   check(out && strstr(out, "(*(coherent device uint*)t12) = r1;"), "const-loads keeps stores");
+   free(out);
+
+   out = kk_shadps4_recipe_apply(kernel_src, "branchless");
+   check(out && strstr(out, "\n    t11 = *(coherent device float*)(t10 ? (ulong)(t12) : t7);\n"
+                            "    r1 = t10 ? (as_type<uint>((t11))) : (as_type<uint>(float(0.0)));"),
+         "branchless rewrites a guarded scalar load");
+   check(out && strstr(out, "t14 = uint4(*(coherent device packed_uint4*)(t13 ? (ulong)(t7 + uint(16u)) : t7));"),
+         "branchless rewrites a wrapped load");
+   check(out && !strstr(out, "if (t10)"), "branchless removes the branch");
+   free(out);
+
+   out = kk_shadps4_recipe_apply(kernel_src, "strip-guards");
+   check(out && strstr(out, "t15 = t9 * t9;"), "strip-guards");
+   free(out);
+
+   out = kk_shadps4_recipe_apply(kernel_src, "hoist=0+16");
+   check(out && strstr(out, "    t7 = *(constant ulong*)(t6);\n"
+                            "    uint4 dsc0 = uint4(*(const device packed_uint4*)(t7 + uint(0u)));\n"
+                            "    uint4 dsc16 = uint4(*(const device packed_uint4*)(t7 + uint(16u)));\n"),
+         "hoist inserts the loads after the table pointer");
+   check(out && strstr(out, "t8 = dsc0;") && strstr(out, "t14 = dsc16;"), "hoist replaces the loads");
+   free(out);
+
+   out = kk_shadps4_recipe_apply(kernel_src, "maxthreads=64");
+   check(out && strstr(out, "[[max_total_threads_per_threadgroup(64)]]\nkernel void"), "maxthreads");
+   free(out);
+
+   check(kk_shadps4_recipe_apply(kernel_src, "no-such-step") == NULL, "unknown step rejected");
+   check(kk_shadps4_recipe_apply("fragment void f() {}\n", "maxthreads=64") == NULL,
+         "a step that does not apply rejects the recipe");
+
+   out = kk_shadps4_recipe_apply(kernel_src, "");
+   check(out && strcmp(out, kernel_src) == 0, "no steps keeps the text, trailing newline included");
+   free(out);
+}
+
+static void
+test_file(void)
+{
+   struct kk_shadps4_recipes r;
+   kk_shadps4_recipes_parse("# comment\n"
+                            "00000000000000ff 0000000000000001 const-loads\n"
+                            "bad line\n"
+                            "0000000000000010 0000000000000002 branchless;const-loads  \n",
+                            &r);
+   check(r.n == 2, "two recipes parsed");
+   const struct kk_shadps4_recipe *a = kk_shadps4_recipes_find(&r, 0x10);
+   check(a && a->result_hash == 2 && strcmp(a->steps, "branchless;const-loads") == 0,
+         "find by key, trailing spaces trimmed");
+   check(kk_shadps4_recipes_find(&r, 0x11) == NULL, "unknown key");
+   for (size_t i = 0; i < r.n; i++)
+      free(r.v[i].steps);
+   free(r.v);
+}
+
+static void
+test_driver_path(void)
+{
+   /* Through kk_shadps4_msl_source with the environment, as the driver calls it. */
+   const char *entry = "shadps4_guest_Compute_00000000test";
+   char *named = kk_shadps4_replace_all(kernel_src, KK_SHADPS4_ENTRY_PLACEHOLDER, entry);
+   uint64_t key = 0;
+   char *normalized = kk_shadps4_msl_normalize(named, entry, &key);
+   char *expect = kk_shadps4_recipe_apply(normalized, "const-loads");
+   const uint64_t good = kk_shadps4_fnv1a64(expect);
+
+   char dir[] = "/tmp/kk_msl_recipe_testXXXXXX";
+   check(mkdtemp(dir) != NULL, "temp dir");
+   char path[512];
+   snprintf(path, sizeof(path), "%s/recipes.txt", dir);
+   FILE *f = fopen(path, "wb");
+   fprintf(f, "%016llx %016llx const-loads\n", (unsigned long long)key, (unsigned long long)good);
+   fclose(f);
+   setenv("KK_SHADPS4_MSL_RECIPES", path, 1);
+   unsetenv("KK_SHADPS4_MSL_OVERRIDE_DIR");
+   unsetenv("KK_SHADPS4_MSL_DUMP_DIR");
+
+   bool owned = false;
+   const char *src = kk_shadps4_msl_source(named, entry, "compute", &owned);
+   char *want = kk_shadps4_replace_all(expect, KK_SHADPS4_ENTRY_PLACEHOLDER, entry);
+   check(owned && strcmp(src, want) == 0, "recipe applied, entry point restored");
+   if (owned)
+      free((void *)src);
+
+   /* A source the recipe does not fit (different key) stays as generated. */
+   const char *other = "kernel void other() {}";
+   src = kk_shadps4_msl_source(other, "other", "compute", &owned);
+   check(!owned && src == other, "no recipe: generated code");
+
+   /* Recipe whose hash does not match: generated code kept. The recipes are loaded once per
+    * process, so check the mismatch path directly. */
+   struct kk_shadps4_recipes bad = {0};
+   char line[128];
+   snprintf(line, sizeof(line), "%016llx %016llx const-loads\n", (unsigned long long)key,
+            (unsigned long long)(good ^ 1));
+   kk_shadps4_recipes_parse(line, &bad);
+   const struct kk_shadps4_recipe *r = kk_shadps4_recipes_find(&bad, key);
+   char *t = r ? kk_shadps4_recipe_apply(normalized, r->steps) : NULL;
+   check(t && kk_shadps4_fnv1a64(t) != r->result_hash, "mismatching hash is detected");
+   free(t);
+   for (size_t i = 0; i < bad.n; i++)
+      free(bad.v[i].steps);
+   free(bad.v);
+
+   /* An override file wins over a recipe. */
+   setenv("KK_SHADPS4_MSL_OVERRIDE_DIR", dir, 1);
+   kk_shadps4_msl_path(path, sizeof(path), dir, key, "metal");
+   f = fopen(path, "wb");
+   fputs("kernel void KK_SHADPS4_ENTRY() { /* override */ }", f);
+   fclose(f);
+   src = kk_shadps4_msl_source(named, entry, "compute", &owned);
+   check(owned && strstr(src, "/* override */") && strstr(src, entry), "override file first");
+   if (owned)
+      free((void *)src);
+   unlink(path);
+   snprintf(path, sizeof(path), "%s/recipes.txt", dir);
+   unlink(path);
+   rmdir(dir);
+
+   free(want);
+   free(expect);
+   free(normalized);
+   free(named);
+}
+
+int
+main(void)
+{
+   test_steps();
+   test_file();
+   test_driver_path();
+   if (failures)
+      return 1;
+   printf("shadps4 msl recipe: all checks passed\n");
+   return 0;
+}
