@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Settings that change generated MSL must be part of the pipeline cache UUID, or a cache written
+ * with one MESA_KK_DISABLE_WORKAROUNDS / MESA_KK_DEBUG value silently feeds shaders compiled
+ * with another (shadPS4 keeps a persistent Vulkan pipeline cache, so a workaround change was not
+ * taking effect until the cache was cleared). Plain C so it can be tested on its own
+ * (test_shadps4_cache_key.c).
+ */
+#ifndef SHADPS4_CACHE_KEY_H
+#define SHADPS4_CACHE_KEY_H
+
+#include <stdint.h>
+#include <string.h>
+
+struct kk_shadps4_cache_key_extra {
+   uint64_t disabled_workarounds;
+   uint64_t debug_flags;
+};
+
+static inline struct kk_shadps4_cache_key_extra
+kk_shadps4_cache_key_extra(uint64_t disabled_workarounds, uint64_t debug_flags)
+{
+   struct kk_shadps4_cache_key_extra key;
+   memset(&key, 0, sizeof(key));
+   key.disabled_workarounds = disabled_workarounds;
+   key.debug_flags = debug_flags;
+   return key;
+}
+
+#endif /* SHADPS4_CACHE_KEY_H */
diff --git a/src/kosmickrisp/vulkan/shadps4_encoder_stats.h b/src/kosmickrisp/vulkan/shadps4_encoder_stats.h
new file mode 100644
index 0000000..3221daa
--- /dev/null
+++ b/src/kosmickrisp/vulkan/shadps4_encoder_stats.h
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Per second Metal encoder statistics (shadPS4 / The Last Guardian performance
+ * work). Enabled with the environment variable KK_SHADPS4_ENCODER_STATS; the
+ * driver then prints one "KK_ENCODER_STATS" line per second to stderr counting
+ * command buffers, render encoder starts by reason, compute encoders, render
+ * passes that ended without draws, barriers recorded while rendering, draws and
+ * dispatches. The counters, the per interval delta and the line format live
+ * here, in plain C, so they can be unit tested (test_shadps4_encoder_stats.c).
+ */
+#ifndef SHADPS4_ENCODER_STATS_H
+#define SHADPS4_ENCODER_STATS_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+
+enum kk_shadps4_render_start_reason {
+   KK_SHADPS4_RENDER_START_BEGIN = 0, /* first draw after vkCmdBeginRendering */
+   KK_SHADPS4_RENDER_START_BARRIER,   /* restarted by a barrier inside the pass */
+   KK_SHADPS4_RENDER_START_COMPUTE,   /* restarted after compute work interrupted the pass */
+   KK_SHADPS4_RENDER_START_STATE,     /* restarted after an attachment or sample change */
+   KK_SHADPS4_RENDER_START_COUNT,
+};
+
+struct kk_shadps4_encoder_stats {
+   uint64_t command_buffers;
+   uint64_t render_starts[KK_SHADPS4_RENDER_START_COUNT];
+   uint64_t compute_after_render; /* compute encoder opened while rendering (ends the pass) */
+   uint64_t compute_fresh;        /* compute encoder opened with no encoder active */
+   uint64_t end_rendering_closed_compute; /* vkCmdEndRendering closed a compute encoder */
+   uint64_t end_rendering_empty;          /* vkCmdEndRendering with no encoder active */
+   uint64_t barriers_in_render;
+   uint64_t barriers_in_render_split;
+   uint64_t draws;
+   uint64_t dispatches;
+   /* Draws unrolled through a compute pre-pass, by reason. */
+   uint64_t unroll_fan;
+   uint64_t unroll_promotion;
+   uint64_t unroll_robustness;
+   uint64_t unroll_restart;
+   uint64_t unroll_flatshade;
+   /* Barriers recorded inside a compute encoder (each one waits for all
+    * earlier dispatches and copies of the encoder), and of those the ones
+    * with no dispatch since the previous one (redundant). */
+   uint64_t compute_barriers;
+   uint64_t compute_barriers_idle;
+};
+
+/* Value of a diagnostic switch such as KK_SHADPS4_DROP_COMPUTE_BARRIERS: on
+ * only when set to "1". */
+static inline bool
+kk_shadps4_env_flag(const char *value)
+{
+   return value != NULL && value[0] == '1' && value[1] == '\0';
+}
+
+/* A compute barrier recorded when `dispatches` dispatches were counted so far:
+ * returns true when none happened since the previous compute barrier. */
+static inline bool
+kk_shadps4_compute_barrier_idle(uint64_t *last_dispatches, uint64_t dispatches)
+{
+   const bool idle = *last_dispatches == dispatches;
+   *last_dispatches = dispatches;
+   return idle;
+}
+
+static inline struct kk_shadps4_encoder_stats
+kk_shadps4_encoder_stats_delta(const struct kk_shadps4_encoder_stats *before,
+                               const struct kk_shadps4_encoder_stats *after)
+{
+   struct kk_shadps4_encoder_stats d;
+   d.command_buffers = after->command_buffers - before->command_buffers;
+   for (unsigned i = 0; i < KK_SHADPS4_RENDER_START_COUNT; i++)
+      d.render_starts[i] = after->render_starts[i] - before->render_starts[i];
+   d.compute_after_render = after->compute_after_render - before->compute_after_render;
+   d.compute_fresh = after->compute_fresh - before->compute_fresh;
+   d.end_rendering_closed_compute =
+      after->end_rendering_closed_compute - before->end_rendering_closed_compute;
+   d.end_rendering_empty = after->end_rendering_empty - before->end_rendering_empty;
+   d.barriers_in_render = after->barriers_in_render - before->barriers_in_render;
+   d.barriers_in_render_split =
+      after->barriers_in_render_split - before->barriers_in_render_split;
+   d.draws = after->draws - before->draws;
+   d.dispatches = after->dispatches - before->dispatches;
+   d.unroll_fan = after->unroll_fan - before->unroll_fan;
+   d.unroll_promotion = after->unroll_promotion - before->unroll_promotion;
+   d.unroll_robustness = after->unroll_robustness - before->unroll_robustness;
+   d.unroll_restart = after->unroll_restart - before->unroll_restart;
+   d.unroll_flatshade = after->unroll_flatshade - before->unroll_flatshade;
+   d.compute_barriers = after->compute_barriers - before->compute_barriers;
+   d.compute_barriers_idle =
+      after->compute_barriers_idle - before->compute_barriers_idle;
+   return d;
+}
+
+static inline uint64_t
+kk_shadps4_encoder_stats_render_starts(const struct kk_shadps4_encoder_stats *s)
+{
+   uint64_t total = 0;
+   for (unsigned i = 0; i < KK_SHADPS4_RENDER_START_COUNT; i++)
+      total += s->render_starts[i];
+   return total;
+}
+
+/* Writes one report line (without newline handling beyond the final one).
+ * Returns the number of characters that would have been written, like
+ * snprintf. */
+static inline int
+kk_shadps4_encoder_stats_format(const struct kk_shadps4_encoder_stats *s,
+                                double seconds, char *buffer, size_t size)
+{
+   return snprintf(
+      buffer, size,
+      "KK_ENCODER_STATS dt=%.2fs cmdbufs=%llu render_enc=%llu begin=%llu "
+      "barrier=%llu after_compute=%llu state=%llu compute_enc=%llu "
+      "after_render=%llu fresh=%llu end_rendering_closed_compute=%llu "
+      "end_rendering_empty=%llu barriers_in_render=%llu split=%llu draws=%llu "
+      "dispatches=%llu unroll_fan=%llu unroll_promotion=%llu "
+      "unroll_robustness=%llu unroll_restart=%llu unroll_flatshade=%llu "
+      "compute_barriers=%llu compute_barriers_idle=%llu\n",
+      seconds, (unsigned long long)s->command_buffers,
+      (unsigned long long)kk_shadps4_encoder_stats_render_starts(s),
+      (unsigned long long)s->render_starts[KK_SHADPS4_RENDER_START_BEGIN],
+      (unsigned long long)s->render_starts[KK_SHADPS4_RENDER_START_BARRIER],
+      (unsigned long long)s->render_starts[KK_SHADPS4_RENDER_START_COMPUTE],
+      (unsigned long long)s->render_starts[KK_SHADPS4_RENDER_START_STATE],
+      (unsigned long long)(s->compute_after_render + s->compute_fresh),
+      (unsigned long long)s->compute_after_render,
+      (unsigned long long)s->compute_fresh,
+      (unsigned long long)s->end_rendering_closed_compute,
+      (unsigned long long)s->end_rendering_empty,
+      (unsigned long long)s->barriers_in_render,
+      (unsigned long long)s->barriers_in_render_split,
+      (unsigned long long)s->draws, (unsigned long long)s->dispatches,
+      (unsigned long long)s->unroll_fan, (unsigned long long)s->unroll_promotion,
+      (unsigned long long)s->unroll_robustness,
+      (unsigned long long)s->unroll_restart,
+      (unsigned long long)s->unroll_flatshade,
+      (unsigned long long)s->compute_barriers,
+      (unsigned long long)s->compute_barriers_idle);
+}
+
+#endif /* SHADPS4_ENCODER_STATS_H */
diff --git a/src/kosmickrisp/vulkan/shadps4_flush_state.h b/src/kosmickrisp/vulkan/shadps4_flush_state.h
new file mode 100644
index 0000000..b713719
--- /dev/null
+++ b/src/kosmickrisp/vulkan/shadps4_flush_state.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Decisions that let the per-draw state flush skip work whose result would not
+ * change (shadPS4 / The Last Guardian performance work, KK_SHADPS4 flush
+ * changes). Each helper answers one question the flush asks, in plain C so that
+ * it can be unit tested (test_shadps4_flush_state.c).
+ */
+#ifndef SHADPS4_FLUSH_STATE_H
+#define SHADPS4_FLUSH_STATE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+/* The attribute clamps and bases of a vertex binding depend only on the
+ * buffer's address and size, so rebinding the same range changes nothing. */
+static inline bool
+kk_shadps4_vb_binding_changed(uint64_t bound_addr, uint64_t bound_range,
+                              uint64_t addr, uint64_t range)
+{
+   return bound_addr != addr || bound_range != range;
+}
+
+/* Argument table slot 0 holds the root address last written to it, which
+ * kk_cmd_buffer.state.root_addr records (zero after a reset, meaning unknown).
+ * A nonzero address equal to that needs no write. Zero is always written. */
+static inline bool
+kk_shadps4_root_bind_needed(uint64_t slot_addr, uint64_t addr)
+{
+   return addr == 0 || slot_addr != addr;
+}
+
+/* Push descriptor bytes equal to the last upload of the set can be read from
+ * that upload: the GPU then sees the same data at the same address. */
+static inline bool
+kk_shadps4_push_upload_reusable(bool uploaded, const void *uploaded_bytes,
+                                const void *data, size_t size)
+{
+   return uploaded && uploaded_bytes != NULL && size > 0 &&
+          memcmp(uploaded_bytes, data, size) == 0;
+}
+
+/* Binding the shader that a graphics stage already has changes nothing. */
+static inline bool
+kk_shadps4_shader_rebind_needed(const void *bound, const void *requested)
+{
+   return bound != requested;
+}
+
+/* Copies src over dst only when the bytes differ. Returns true when dst
+ * changed, so the caller marks the root table dirty only then. */
+static inline bool
+kk_shadps4_copy_if_changed(void *dst, const void *src, size_t size)
+{
+   if (memcmp(dst, src, size) == 0)
+      return false;
+   memcpy(dst, src, size);
+   return true;
+}
+
+#endif
diff --git a/src/kosmickrisp/vulkan/shadps4_msl_override.h b/src/kosmickrisp/vulkan/shadps4_msl_override.h
new file mode 100644
index 0000000..386010e
--- /dev/null
+++ b/src/kosmickrisp/vulkan/shadps4_msl_override.h
@@ -0,0 +1,213 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Tuned Metal shaders for shadPS4 / The Last Guardian.
+ *
+ * KK_SHADPS4_MSL_DUMP_DIR=<dir> writes every Metal shader the driver compiles as
+ * <dir>/<key>.metal (plus <key>.txt with its entry point name and stage), and
+ * KK_SHADPS4_MSL_OVERRIDE_DIR=<dir> compiles <dir>/<key>.metal instead of the
+ * generated source when that file exists. The key is a 64-bit FNV-1a hash of the
+ * generated source with the entry point name replaced by KK_SHADPS4_ENTRY, so a
+ * shader keeps its key whether or not the emulator gives entry points diagnostic
+ * names; the files hold that placeholder and it is put back when loading.
+ * Overrides apply where Metal libraries are created, after the pipeline cache,
+ * so cached pipelines always keep the generated source.
+ *
+ * KK_SHADPS4_MSL_RECIPES=<file> tunes shaders without shipping their code: for a shader with no
+ * override file, a recipe (shadps4_msl_recipe.h) rewrites the generated source and the result is
+ * used only if its hash matches the one the recipe was verified with.
+ */
+#ifndef SHADPS4_MSL_OVERRIDE_H
+#define SHADPS4_MSL_OVERRIDE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <pthread.h>
+
+#include "shadps4_msl_recipe.h"
+
+#define KK_SHADPS4_ENTRY_PLACEHOLDER "KK_SHADPS4_ENTRY"
+
+/* `text` with every occurrence of `from` replaced by `to` (malloc'd; NULL on failure). */
+static inline char *
+kk_shadps4_replace_all(const char *text, const char *from, const char *to)
+{
+   const size_t from_len = strlen(from), to_len = strlen(to);
+   if (from_len == 0)
+      return strdup(text);
+   size_t count = 0;
+   for (const char *p = strstr(text, from); p; p = strstr(p + from_len, from))
+      count++;
+   const size_t len = strlen(text) + count * to_len - count * from_len;
+   char *out = malloc(len + 1);
+   if (!out)
+      return NULL;
+   char *w = out;
+   const char *r = text;
+   for (const char *p = strstr(r, from); p; p = strstr(r, from)) {
+      memcpy(w, r, (size_t)(p - r));
+      w += p - r;
+      memcpy(w, to, to_len);
+      w += to_len;
+      r = p + from_len;
+   }
+   strcpy(w, r);
+   return out;
+}
+
+static inline uint64_t
+kk_shadps4_fnv1a64(const char *text)
+{
+   uint64_t hash = 0xcbf29ce484222325ull;
+   for (const unsigned char *p = (const unsigned char *)text; *p; ++p) {
+      hash ^= *p;
+      hash *= 0x100000001b3ull;
+   }
+   return hash;
+}
+
+/* The source with the entry point name normalized (malloc'd) and its key. */
+static inline char *
+kk_shadps4_msl_normalize(const char *code, const char *entrypoint, uint64_t *key)
+{
+   char *normalized = kk_shadps4_replace_all(code, entrypoint ? entrypoint : "",
+                                             KK_SHADPS4_ENTRY_PLACEHOLDER);
+   if (normalized && key)
+      *key = kk_shadps4_fnv1a64(normalized);
+   return normalized;
+}
+
+static inline void
+kk_shadps4_msl_path(char *out, size_t size, const char *dir, uint64_t key, const char *ext)
+{
+   snprintf(out, size, "%s/%016llx.%s", dir, (unsigned long long)key, ext);
+}
+
+static inline char *
+kk_shadps4_read_file(const char *path)
+{
+   FILE *f = fopen(path, "rb");
+   if (!f)
+      return NULL;
+   fseek(f, 0, SEEK_END);
+   long size = ftell(f);
+   fseek(f, 0, SEEK_SET);
+   char *data = size >= 0 ? malloc((size_t)size + 1) : NULL;
+   if (data) {
+      size_t got = fread(data, 1, (size_t)size, f);
+      data[got] = '\0';
+   }
+   fclose(f);
+   return data;
+}
+
+static struct kk_shadps4_recipes kk_shadps4_loaded_recipes;
+static pthread_once_t kk_shadps4_recipes_once = PTHREAD_ONCE_INIT;
+
+static inline void
+kk_shadps4_load_recipes(void)
+{
+   const char *path = getenv("KK_SHADPS4_MSL_RECIPES");
+   char *text = path && *path ? kk_shadps4_read_file(path) : NULL;
+   if (text) {
+      kk_shadps4_recipes_parse(text, &kk_shadps4_loaded_recipes);
+      free(text);
+      fprintf(stderr, "KK_SHADPS4_MSL_RECIPES %zu recipes\n", kk_shadps4_loaded_recipes.n);
+   }
+}
+
+/* The recipe result for `normalized` (malloc'd, entry point still the placeholder), or NULL. */
+static inline char *
+kk_shadps4_msl_recipe_source(const char *normalized, uint64_t key, const char *stage)
+{
+   pthread_once(&kk_shadps4_recipes_once, kk_shadps4_load_recipes);
+   const struct kk_shadps4_recipe *r = kk_shadps4_recipes_find(&kk_shadps4_loaded_recipes, key);
+   if (!r)
+      return NULL;
+   char *tuned = kk_shadps4_recipe_apply(normalized, r->steps);
+   const bool match = tuned && kk_shadps4_fnv1a64(tuned) == r->result_hash;
+   static int logged;
+   if (logged++ < 256)
+      fprintf(stderr, "KK_SHADPS4_MSL_RECIPE %016llx (%s) %s\n", (unsigned long long)key, stage,
+              match ? "applied" : "hash mismatch, generated code kept");
+   if (!match) {
+      free(tuned);
+      return NULL;
+   }
+   return tuned;
+}
+
+/* Dumps and/or overrides one shader source; returns the source to compile: either
+ * `code` itself or a malloc'd override the caller frees (`*owned` is set then). */
+static inline const char *
+kk_shadps4_msl_source(const char *code, const char *entrypoint, const char *stage,
+                      bool *owned)
+{
+   *owned = false;
+   const char *dump_dir = getenv("KK_SHADPS4_MSL_DUMP_DIR");
+   const char *override_dir = getenv("KK_SHADPS4_MSL_OVERRIDE_DIR");
+   const char *recipes = getenv("KK_SHADPS4_MSL_RECIPES");
+   if ((!dump_dir || !*dump_dir) && (!override_dir || !*override_dir) && (!recipes || !*recipes))
+      return code;
+   uint64_t key = 0;
+   char *normalized = kk_shadps4_msl_normalize(code, entrypoint, &key);
+   if (!normalized)
+      return code;
+   char path[1024];
+   if (dump_dir && *dump_dir) {
+      kk_shadps4_msl_path(path, sizeof(path), dump_dir, key, "metal");
+      FILE *existing = fopen(path, "rb");
+      if (existing) {
+         fclose(existing);
+      } else {
+         FILE *f = fopen(path, "wb");
+         if (f) {
+            fputs(normalized, f);
+            fclose(f);
+         }
+         kk_shadps4_msl_path(path, sizeof(path), dump_dir, key, "txt");
+         f = fopen(path, "wb");
+         if (f) {
+            fprintf(f, "entry %s\nstage %s\n", entrypoint ? entrypoint : "", stage);
+            fclose(f);
+         }
+      }
+   }
+   const char *result = code;
+   if (override_dir && *override_dir) {
+      kk_shadps4_msl_path(path, sizeof(path), override_dir, key, "metal");
+      char *tuned = kk_shadps4_read_file(path);
+      if (tuned) {
+         char *restored = kk_shadps4_replace_all(tuned, KK_SHADPS4_ENTRY_PLACEHOLDER,
+                                                 entrypoint ? entrypoint : "");
+         free(tuned);
+         if (restored) {
+            result = restored;
+            *owned = true;
+            static int logged;
+            if (logged++ < 64)
+               fprintf(stderr, "KK_SHADPS4_MSL_OVERRIDE %016llx (%s)\n",
+                       (unsigned long long)key, stage);
+         }
+      }
+   }
+   if (result == code && recipes && *recipes) {
+      char *tuned = kk_shadps4_msl_recipe_source(normalized, key, stage);
+      if (tuned) {
+         char *restored = kk_shadps4_replace_all(tuned, KK_SHADPS4_ENTRY_PLACEHOLDER,
+                                                 entrypoint ? entrypoint : "");
+         free(tuned);
+         if (restored) {
+            result = restored;
+            *owned = true;
+         }
+      }
+   }
+   free(normalized);
+   return result;
+}
+
+#endif
diff --git a/src/kosmickrisp/vulkan/shadps4_msl_recipe.h b/src/kosmickrisp/vulkan/shadps4_msl_recipe.h
new file mode 100644
index 0000000..e354532
--- /dev/null
+++ b/src/kosmickrisp/vulkan/shadps4_msl_recipe.h
@@ -0,0 +1,702 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Shader recipes for shadPS4 / The Last Guardian.
+ *
+ * A recipe tunes one generated Metal shader without shipping any shader code: it names the
+ * shader by its key (see shadps4_msl_override.h), lists text rewrite steps that are applied
+ * to the generated source, and gives the FNV-1a 64 hash of the expected result. The result is
+ * compiled only when its hash matches, so a recipe can only ever produce the exact source it was
+ * verified with; anything else (another driver version, another emulator build) falls back to
+ * the generated source.
+ *
+ * KK_SHADPS4_MSL_RECIPES=<file> loads the recipes, one per line:
+ *     <key, 16 hex> <result hash, 16 hex> <step>;<step>;...
+ * Lines starting with '#' are comments. Steps, applied in order to the normalized source:
+ *     const-loads     "*(coherent device " -> "*(const device " on every line that is not a store
+ *                     (a store line starts, after spaces, with "*(" or "(*(")
+ *     branchless      a bounds-checked load
+ *                         if (c) { x = *(Q T*)(A); r = E; } else { r = D; }
+ *                     becomes  x = *(Q T*)(c ? (ulong)(A) : TABLE); r = c ? (E) : (D);
+ *                     where TABLE is the descriptor-table pointer the shader already reads
+ *     strip-guards    removes every "!&buf0.contents[0] ? 1 : "
+ *     hoist=O+O+...   loads the descriptor-table entries at these byte offsets once, right after
+ *                     the table pointer is set
+ *     maxthreads=N    adds [[max_total_threads_per_threadgroup(N)]] before the kernel
+ * The reference implementation (and the tool that makes recipes) is msl-recipe in the
+ * project's shader tuning kit; this file must match it byte for byte.
+ */
+#ifndef SHADPS4_MSL_RECIPE_H
+#define SHADPS4_MSL_RECIPE_H
+
+#include <ctype.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* ---- growable list of lines ------------------------------------------------------------- */
+
+struct kk_rcp_lines {
+   char **v;
+   size_t n, cap;
+};
+
+static inline bool
+kk_rcp_push(struct kk_rcp_lines *l, char *s)
+{
+   if (!s)
+      return false;
+   if (l->n == l->cap) {
+      size_t cap = l->cap ? l->cap * 2 : 256;
+      char **v = realloc(l->v, cap * sizeof(char *));
+      if (!v) {
+         free(s);
+         return false;
+      }
+      l->v = v;
+      l->cap = cap;
+   }
+   l->v[l->n++] = s;
+   return true;
+}
+
+static inline void
+kk_rcp_free(struct kk_rcp_lines *l)
+{
+   for (size_t i = 0; i < l->n; i++)
+      free(l->v[i]);
+   free(l->v);
+   l->v = NULL;
+   l->n = l->cap = 0;
+}
+
+static inline char *
+kk_rcp_strndup(const char *s, size_t n)
+{
+   char *r = malloc(n + 1);
+   if (r) {
+      memcpy(r, s, n);
+      r[n] = '\0';
+   }
+   return r;
+}
+
+static inline char *
+kk_rcp_printf(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+
+static inline char *
+kk_rcp_printf(const char *fmt, ...)
+{
+   va_list ap;
+   va_start(ap, fmt);
+   int len = vsnprintf(NULL, 0, fmt, ap);
+   va_end(ap);
+   if (len < 0)
+      return NULL;
+   char *s = malloc((size_t)len + 1);
+   if (!s)
+      return NULL;
+   va_start(ap, fmt);
+   vsnprintf(s, (size_t)len + 1, fmt, ap);
+   va_end(ap);
+   return s;
+}
+
+/* Splits on '\n' exactly like Python's str.split('\n'). */
+static inline bool
+kk_rcp_split(const char *text, struct kk_rcp_lines *out)
+{
+   const char *start = text;
+   for (const char *p = text;; p++) {
+      if (*p == '\n' || *p == '\0') {
+         if (!kk_rcp_push(out, kk_rcp_strndup(start, (size_t)(p - start))))
+            return false;
+         if (*p == '\0')
+            return true;
+         start = p + 1;
+      }
+   }
+}
+
+static inline char *
+kk_rcp_join(const struct kk_rcp_lines *l)
+{
+   size_t len = 0;
+   for (size_t i = 0; i < l->n; i++)
+      len += strlen(l->v[i]) + 1;
+   char *out = malloc(len + 1);
+   if (!out)
+      return NULL;
+   char *w = out;
+   for (size_t i = 0; i < l->n; i++) {
+      size_t k = strlen(l->v[i]);
+      memcpy(w, l->v[i], k);
+      w += k;
+      if (i + 1 < l->n)
+         *w++ = '\n';
+   }
+   *w = '\0';
+   return out;
+}
+
+/* ---- small string helpers (Python semantics) --------------------------------------------- */
+
+static inline bool kk_rcp_starts(const char *s, const char *p) { return strncmp(s, p, strlen(p)) == 0; }
+
+static inline bool
+kk_rcp_ends(const char *s, const char *p)
+{
+   size_t a = strlen(s), b = strlen(p);
+   return a >= b && memcmp(s + a - b, p, b) == 0;
+}
+
+static inline const char *kk_rcp_lstrip_spaces(const char *s) { while (*s == ' ') s++; return s; }
+
+static inline bool
+kk_rcp_is_ident_n(const char *s, size_t n)
+{
+   if (n == 0)
+      return false;
+   for (size_t i = 0; i < n; i++)
+      if (!isalnum((unsigned char)s[i]) && s[i] != '_')
+         return false;
+   return true;
+}
+
+static inline bool
+kk_rcp_is_temp_n(const char *s, size_t n)
+{
+   if (n < 2 || s[0] != 't')
+      return false;
+   for (size_t i = 1; i < n; i++)
+      if (!isdigit((unsigned char)s[i]))
+         return false;
+   return true;
+}
+
+static inline bool
+kk_rcp_is_digits_n(const char *s, size_t n)
+{
+   if (n == 0)
+      return false;
+   for (size_t i = 0; i < n; i++)
+      if (!isdigit((unsigned char)s[i]))
+         return false;
+   return true;
+}
+
+static inline bool kk_rcp_toplevel(const char *l) { return kk_rcp_starts(l, "    ") && !kk_rcp_starts(l, "     "); }
+
+/* Python str.strip() for the whitespace generated code contains. */
+static inline bool
+kk_rcp_strip_equals(const char *s, const char *want)
+{
+   while (*s && isspace((unsigned char)*s))
+      s++;
+   size_t n = strlen(s);
+   while (n && isspace((unsigned char)s[n - 1]))
+      n--;
+   return n == strlen(want) && memcmp(s, want, n) == 0;
+}
+
+static inline size_t
+kk_rcp_count(const char *s, const char *pat)
+{
+   size_t n = 0, k = strlen(pat);
+   for (const char *p = strstr(s, pat); p; p = strstr(p + k, pat))
+      n++;
+   return n;
+}
+
+/* Replaces every occurrence in place (frees the old string). */
+static inline bool
+kk_rcp_replace(char **line, const char *from, const char *to)
+{
+   if (!strstr(*line, from))
+      return true;
+   size_t fl = strlen(from), tl = strlen(to), count = kk_rcp_count(*line, from);
+   char *out = malloc(strlen(*line) + count * tl - count * fl + 1);
+   if (!out)
+      return false;
+   char *w = out;
+   const char *r = *line;
+   for (const char *p = strstr(r, from); p; p = strstr(r, from)) {
+      memcpy(w, r, (size_t)(p - r));
+      w += p - r;
+      memcpy(w, to, tl);
+      w += tl;
+      r = p + fl;
+   }
+   strcpy(w, r);
+   free(*line);
+   *line = out;
+   return true;
+}
+
+static inline bool
+kk_rcp_mentions(const char *text, const char *name)
+{
+   size_t k = strlen(name);
+   for (const char *p = strstr(text, name); p; p = strstr(p + 1, name)) {
+      char before = p > text ? p[-1] : ' ';
+      char after = p[k] ? p[k] : ' ';
+      if (!(isalnum((unsigned char)before) || before == '_') &&
+          !(isalnum((unsigned char)after) || after == '_'))
+         return true;
+   }
+   return false;
+}
+
+/* ---- steps ------------------------------------------------------------------------------- */
+
+static inline bool
+kk_rcp_is_store(const char *line)
+{
+   const char *s = kk_rcp_lstrip_spaces(line);
+   return kk_rcp_starts(s, "*(") || kk_rcp_starts(s, "(*(");
+}
+
+static inline long
+kk_rcp_const_loads(struct kk_rcp_lines *l)
+{
+   long n = 0;
+   for (size_t i = 0; i < l->n; i++) {
+      if (kk_rcp_is_store(l->v[i]) || !strstr(l->v[i], "*(coherent device "))
+         continue;
+      n += (long)kk_rcp_count(l->v[i], "*(coherent device ");
+      if (!kk_rcp_replace(&l->v[i], "*(coherent device ", "*(const device "))
+         return -1;
+   }
+   return n;
+}
+
+static inline long
+kk_rcp_strip_guards(struct kk_rcp_lines *l)
+{
+   long n = 0;
+   for (size_t i = 0; i < l->n; i++) {
+      n += (long)kk_rcp_count(l->v[i], "!&buf0.contents[0] ? 1 : ");
+      if (!kk_rcp_replace(&l->v[i], "!&buf0.contents[0] ? 1 : ", ""))
+         return -1;
+   }
+   return n;
+}
+
+/* The descriptor-table pointer B (written to `base`, size 32) and the index of its only
+ * assignment; false when there is none. */
+static inline bool
+kk_rcp_find_table(const struct kk_rcp_lines *l, char *base, size_t *assign)
+{
+   static const char *const quals[] = {"coherent device packed_uint4*)(",
+                                       "const device packed_uint4*)(",
+                                       "device packed_uint4*)("};
+   base[0] = '\0';
+   for (size_t i = 0; i < l->n && !base[0]; i++) {
+      const char *line = l->v[i];
+      if (!kk_rcp_toplevel(line))
+         continue;
+      const char *body = line + 4;
+      const char *eq = strstr(body, " = uint4(*(");
+      if (!eq || eq == body || !kk_rcp_is_ident_n(body, (size_t)(eq - body)))
+         continue;
+      const char *rest = eq + strlen(" = uint4(*(");
+      bool ok = false;
+      for (int q = 0; q < 3 && !ok; q++)
+         if (kk_rcp_starts(rest, quals[q])) {
+            rest += strlen(quals[q]);
+            ok = true;
+         }
+      if (!ok)
+         continue;
+      const char *sp = strstr(rest, " + uint(");
+      if (!sp || sp == rest || !kk_rcp_is_temp_n(rest, (size_t)(sp - rest)))
+         continue;
+      const char *tail = sp + strlen(" + uint(");
+      size_t tl = strlen(tail), suf = strlen("u)));");
+      if (tl < suf || !kk_rcp_ends(tail, "u)));") || !kk_rcp_is_digits_n(tail, tl - suf))
+         continue;
+      size_t bl = (size_t)(sp - rest);
+      if (bl >= 32)
+         continue;
+      memcpy(base, rest, bl);
+      base[bl] = '\0';
+   }
+   if (!base[0])
+      return false;
+   char prefix[40];
+   snprintf(prefix, sizeof(prefix), "%s = ", base);
+   size_t count = 0;
+   for (size_t i = 0; i < l->n; i++)
+      if (kk_rcp_starts(kk_rcp_lstrip_spaces(l->v[i]), prefix)) {
+         count++;
+         *assign = i;
+      }
+   return count == 1;
+}
+
+struct kk_rcp_load {
+   size_t ind;
+   char x[64], wrap[32], qual[32], ty[32];
+   const char *addr;
+   size_t addr_len;
+   bool wrapped;
+};
+
+/* Python parse_load: "<ind><x> = [W(]*(<q> <ty>*)(<addr>)[)];" */
+static inline bool
+kk_rcp_parse_load(const char *line, struct kk_rcp_load *ld)
+{
+   ld->ind = (size_t)(kk_rcp_lstrip_spaces(line) - line);
+   const char *body = line + ld->ind;
+   const char *eq = strstr(body, " = ");
+   size_t blen = strlen(body);
+   if (!eq || eq == body || !kk_rcp_is_ident_n(body, (size_t)(eq - body)) || !blen ||
+       body[blen - 1] != ';' || (size_t)(eq - body) >= sizeof(ld->x))
+      return false;
+   memcpy(ld->x, body, (size_t)(eq - body));
+   ld->x[eq - body] = '\0';
+   const char *rhs = eq + 3;
+   size_t rlen = (size_t)(body + blen - 1 - rhs); /* without ';' */
+   ld->wrapped = false;
+   if (!(rlen >= 2 && rhs[0] == '*' && rhs[1] == '(')) {
+      const char *p = strstr(rhs, "(*(");
+      if (!p || p == rhs || (size_t)(p - rhs) >= rlen || !kk_rcp_is_ident_n(rhs, (size_t)(p - rhs)) ||
+          (size_t)(p - rhs) >= sizeof(ld->wrap))
+         return false;
+      memcpy(ld->wrap, rhs, (size_t)(p - rhs));
+      ld->wrap[p - rhs] = '\0';
+      ld->wrapped = true;
+      rlen -= (size_t)(p + 1 - rhs);
+      rhs = p + 1;
+   }
+   /* rhs[0..rlen) = "*(<q> <ty>*)(<addr>)" (+ ")" when wrapped) */
+   const char *close = strstr(rhs, "*)(");
+   if (!close || (size_t)(close - rhs) + 3 > rlen)
+      return false;
+   const char *qt = rhs + 2;
+   size_t qtl = (size_t)(close - qt);
+   static const char *const quals[] = {"coherent device ", "const device ", "device "};
+   int qi = -1;
+   for (int q = 0; q < 3; q++)
+      if (qtl >= strlen(quals[q]) && strncmp(qt, quals[q], strlen(quals[q])) == 0) {
+         qi = q;
+         break;
+      }
+   if (qi < 0)
+      return false;
+   size_t ql = strlen(quals[qi]);
+   if (!kk_rcp_is_ident_n(qt + ql, qtl - ql) || qtl - ql >= sizeof(ld->ty))
+      return false;
+   memcpy(ld->qual, quals[qi], ql - 1);
+   ld->qual[ql - 1] = '\0';
+   memcpy(ld->ty, qt + ql, qtl - ql);
+   ld->ty[qtl - ql] = '\0';
+   const char *addr = close + 3;
+   size_t al = rlen - (size_t)(addr - rhs);
+   if (ld->wrapped) {
+      if (al < 2 || addr[al - 1] != ')' || addr[al - 2] != ')')
+         return false;
+      al -= 2;
+   } else {
+      if (al < 1 || addr[al - 1] != ')' || (al >= 2 && addr[al - 2] == ')'))
+         return false;
+      al -= 1;
+   }
+   if (al == 0)
+      return false;
+   ld->addr = addr;
+   ld->addr_len = al;
+   return true;
+}
+
+/* Python parse_assign on the stripped line: "<x> = <rhs>;" */
+static inline bool
+kk_rcp_parse_assign(const char *line, char *x, size_t xsize, const char **rhs, size_t *rlen)
+{
+   const char *s = kk_rcp_lstrip_spaces(line);
+   const char *eq = strstr(s, " = ");
+   size_t sl = strlen(s);
+   if (!eq || eq == s || !kk_rcp_is_ident_n(s, (size_t)(eq - s)) || !sl || s[sl - 1] != ';' ||
+       (size_t)(eq - s) >= xsize)
+      return false;
+   memcpy(x, s, (size_t)(eq - s));
+   x[eq - s] = '\0';
+   *rhs = eq + 3;
+   *rlen = (size_t)(s + sl - 1 - *rhs);
+   return true;
+}
+
+static inline int
+kk_rcp_type_size(const char *ty)
+{
+   static const struct { const char *n; int s; } sizes[] = {
+      {"float", 4}, {"uint", 4}, {"int", 4}, {"half", 2}, {"ushort", 2}, {"short", 2},
+      {"uchar", 1}, {"char", 1}, {"packed_uint2", 8}, {"packed_float2", 8},
+      {"packed_uint4", 16}, {"packed_float4", 16}, {"ulong", 8}, {"packed_uint3", 12},
+      {"packed_float3", 12}, {"uint2", 8}, {"float2", 8}, {"uint4", 16}, {"float4", 16}};
+   for (size_t i = 0; i < sizeof(sizes) / sizeof(sizes[0]); i++)
+      if (strcmp(sizes[i].n, ty) == 0)
+         return sizes[i].s;
+   return 99;
+}
+
+static inline long
+kk_rcp_branchless(struct kk_rcp_lines *l)
+{
+   char base[32];
+   size_t base_line = 0;
+   if (!kk_rcp_find_table(l, base, &base_line))
+      return 0;
+   char use[48];
+   snprintf(use, sizeof(use), "(%s + uint(", base);
+   size_t first_use = SIZE_MAX;
+   for (size_t i = base_line + 1; i < l->n; i++)
+      if (kk_rcp_toplevel(l->v[i]) && strstr(l->v[i], use)) {
+         first_use = i;
+         break;
+      }
+   if (first_use == SIZE_MAX)
+      return 0;
+   struct kk_rcp_lines out = {0};
+   long n = 0;
+   size_t i = 0;
+   while (i < l->n) {
+      const char *line = l->v[i];
+      const char *s = kk_rcp_lstrip_spaces(line);
+      size_t sl = strlen(s);
+      if (i > first_use && i + 5 < l->n && kk_rcp_starts(s, "if (") && sl >= 7 &&
+          kk_rcp_ends(s, ") {") && kk_rcp_is_temp_n(s + 4, sl - 7)) {
+         char c[32];
+         size_t cl = sl - 7 < sizeof(c) - 1 ? sl - 7 : sizeof(c) - 1;
+         memcpy(c, s + 4, cl);
+         c[cl] = '\0';
+         size_t ind = (size_t)(s - line);
+         struct kk_rcp_load ld;
+         char a1x[64], a2x[64];
+         const char *a1r, *a2r;
+         size_t a1l, a2l;
+         if (kk_rcp_parse_load(l->v[i + 1], &ld) &&
+             kk_rcp_parse_assign(l->v[i + 2], a1x, sizeof(a1x), &a1r, &a1l) &&
+             kk_rcp_parse_assign(l->v[i + 4], a2x, sizeof(a2x), &a2r, &a2l) &&
+             kk_rcp_strip_equals(l->v[i + 3], "} else {") && kk_rcp_strip_equals(l->v[i + 5], "}") &&
+             strcmp(a1x, a2x) == 0 && kk_rcp_type_size(ld.ty) <= 16) {
+            char *e1 = kk_rcp_strndup(a1r, a1l), *e2 = kk_rcp_strndup(a2r, a2l);
+            char *addr = kk_rcp_strndup(ld.addr, ld.addr_len);
+            if (!e1 || !e2 || !addr) {
+               free(e1); free(e2); free(addr);
+               kk_rcp_free(&out);
+               return -1;
+            }
+            if (kk_rcp_mentions(e1, ld.x) && !kk_rcp_mentions(e2, ld.x)) {
+               char *load = kk_rcp_printf("*(%s %s*)(%s ? (ulong)(%s) : %s)", ld.qual, ld.ty, c,
+                                          addr, base);
+               char *l1 = NULL, *l2 = NULL;
+               if (load) {
+                  if (ld.wrapped)
+                     l1 = kk_rcp_printf("%.*s%s = %s(%s);", (int)ind, line, ld.x, ld.wrap, load);
+                  else
+                     l1 = kk_rcp_printf("%.*s%s = %s;", (int)ind, line, ld.x, load);
+                  l2 = kk_rcp_printf("%.*s%s = %s ? (%s) : (%s);", (int)ind, line, a1x, c, e1, e2);
+               }
+               free(load); free(e1); free(e2); free(addr);
+               if (!kk_rcp_push(&out, l1) || !kk_rcp_push(&out, l2)) {
+                  kk_rcp_free(&out);
+                  return -1;
+               }
+               n++;
+               i += 6;
+               continue;
+            }
+            free(e1); free(e2); free(addr);
+         }
+      }
+      if (!kk_rcp_push(&out, strdup(line))) {
+         kk_rcp_free(&out);
+         return -1;
+      }
+      i++;
+   }
+   kk_rcp_free(l);
+   *l = out;
+   return n;
+}
+
+static inline long
+kk_rcp_hoist(struct kk_rcp_lines *l, const unsigned *offs, size_t noffs)
+{
+   char base[32];
+   size_t base_line = 0;
+   if (!kk_rcp_find_table(l, base, &base_line))
+      return 0;
+   static const char *const quals[] = {"coherent device ", "const device ", "device "};
+   long n = 0;
+   for (size_t i = 0; i < l->n; i++)
+      for (size_t o = 0; o < noffs; o++)
+         for (int q = 0; q < 3; q++) {
+            char pat[128], rep[32];
+            snprintf(pat, sizeof(pat), "uint4(*(%spacked_uint4*)(%s + uint(%uu)))", quals[q], base,
+                     offs[o]);
+            if (!strstr(l->v[i], pat))
+               continue;
+            snprintf(rep, sizeof(rep), "dsc%u", offs[o]);
+            n += (long)kk_rcp_count(l->v[i], pat);
+            if (!kk_rcp_replace(&l->v[i], pat, rep))
+               return -1;
+         }
+   /* insert the loads after the table pointer's assignment */
+   for (size_t o = noffs; o-- > 0;) {
+      char *decl = kk_rcp_printf("    uint4 dsc%u = uint4(*(const device packed_uint4*)(%s + uint(%uu)));",
+                                 offs[o], base, offs[o]);
+      if (!kk_rcp_push(l, decl))
+         return -1;
+      memmove(&l->v[base_line + 2], &l->v[base_line + 1], (l->n - 2 - base_line) * sizeof(char *));
+      l->v[base_line + 1] = decl;
+   }
+   return n;
+}
+
+static inline long
+kk_rcp_maxthreads(struct kk_rcp_lines *l, unsigned threads)
+{
+   for (size_t i = 0; i < l->n; i++)
+      if (kk_rcp_starts(l->v[i], "kernel void ")) {
+         char *attr = kk_rcp_printf("[[max_total_threads_per_threadgroup(%u)]]", threads);
+         if (!kk_rcp_push(l, attr))
+            return -1;
+         memmove(&l->v[i + 1], &l->v[i], (l->n - 1 - i) * sizeof(char *));
+         l->v[i] = attr;
+         return 1;
+      }
+   return 0;
+}
+
+/* Applies `steps` to `source`; returns the malloc'd result, or NULL when a step is unknown,
+ * did not apply, or memory ran out. */
+static inline char *
+kk_shadps4_recipe_apply(const char *source, const char *steps)
+{
+   struct kk_rcp_lines l = {0};
+   if (!kk_rcp_split(source, &l)) {
+      kk_rcp_free(&l);
+      return NULL;
+   }
+   const char *p = steps;
+   bool ok = true;
+   while (ok && *p) {
+      const char *end = strchr(p, ';');
+      size_t len = end ? (size_t)(end - p) : strlen(p);
+      char step[256];
+      if (len >= sizeof(step)) {
+         ok = false;
+         break;
+      }
+      memcpy(step, p, len);
+      step[len] = '\0';
+      p += len + (end ? 1 : 0);
+      if (!len)
+         continue;
+      long n;
+      if (strcmp(step, "const-loads") == 0) {
+         n = kk_rcp_const_loads(&l);
+      } else if (strcmp(step, "branchless") == 0) {
+         n = kk_rcp_branchless(&l);
+      } else if (strcmp(step, "strip-guards") == 0) {
+         n = kk_rcp_strip_guards(&l);
+      } else if (strncmp(step, "hoist=", 6) == 0) {
+         unsigned offs[64];
+         size_t noffs = 0;
+         for (char *q = step + 6; *q && noffs < 64;) {
+            char *e;
+            unsigned long v = strtoul(q, &e, 10);
+            if (e == q)
+               break;
+            offs[noffs++] = (unsigned)v;
+            q = *e == '+' ? e + 1 : e;
+         }
+         n = noffs ? kk_rcp_hoist(&l, offs, noffs) : 0;
+      } else if (strncmp(step, "maxthreads=", 11) == 0) {
+         n = kk_rcp_maxthreads(&l, (unsigned)strtoul(step + 11, NULL, 10));
+      } else {
+         n = 0;
+      }
+      ok = n > 0;
+   }
+   char *out = ok ? kk_rcp_join(&l) : NULL;
+   kk_rcp_free(&l);
+   return out;
+}
+
+/* ---- the recipe file --------------------------------------------------------------------- */
+
+struct kk_shadps4_recipe {
+   uint64_t key, result_hash;
+   char *steps;
+};
+
+struct kk_shadps4_recipes {
+   struct kk_shadps4_recipe *v;
+   size_t n;
+};
+
+static inline int
+kk_rcp_cmp(const void *a, const void *b)
+{
+   uint64_t x = ((const struct kk_shadps4_recipe *)a)->key;
+   uint64_t y = ((const struct kk_shadps4_recipe *)b)->key;
+   return x < y ? -1 : x > y;
+}
+
+/* Parses recipe text; malformed lines are skipped. */
+static inline void
+kk_shadps4_recipes_parse(const char *text, struct kk_shadps4_recipes *r)
+{
+   r->v = NULL;
+   r->n = 0;
+   size_t cap = 0;
+   for (const char *line = text; line && *line;) {
+      const char *nl = strchr(line, '\n');
+      size_t len = nl ? (size_t)(nl - line) : strlen(line);
+      if (len && line[0] != '#') {
+         unsigned long long key, hash;
+         int consumed = 0;
+         char *copy = kk_rcp_strndup(line, len);
+         if (copy && sscanf(copy, "%16llx %16llx %n", &key, &hash, &consumed) == 2 && consumed) {
+            char *steps = copy + consumed;
+            size_t sl = strlen(steps);
+            while (sl && isspace((unsigned char)steps[sl - 1]))
+               steps[--sl] = '\0';
+            if (sl) {
+               if (r->n == cap) {
+                  cap = cap ? cap * 2 : 64;
+                  struct kk_shadps4_recipe *v = realloc(r->v, cap * sizeof(*v));
+                  if (!v) {
+                     free(copy);
+                     break;
+                  }
+                  r->v = v;
+               }
+               r->v[r->n].key = key;
+               r->v[r->n].result_hash = hash;
+               r->v[r->n].steps = strdup(steps);
+               if (r->v[r->n].steps)
+                  r->n++;
+            }
+         }
+         free(copy);
+      }
+      line = nl ? nl + 1 : NULL;
+   }
+   if (r->n)
+      qsort(r->v, r->n, sizeof(r->v[0]), kk_rcp_cmp);
+}
+
+static inline const struct kk_shadps4_recipe *
+kk_shadps4_recipes_find(const struct kk_shadps4_recipes *r, uint64_t key)
+{
+   struct kk_shadps4_recipe probe = {.key = key};
+   return r->n ? bsearch(&probe, r->v, r->n, sizeof(r->v[0]), kk_rcp_cmp) : NULL;
+}
+
+#endif
diff --git a/src/kosmickrisp/vulkan/shadps4_root_trim.h b/src/kosmickrisp/vulkan/shadps4_root_trim.h
new file mode 100644
index 0000000..fc9172a
--- /dev/null
+++ b/src/kosmickrisp/vulkan/shadps4_root_trim.h
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Smaller root descriptor uploads (shadPS4 / The Last Guardian performance
+ * work, KK_SHADPS4_TRIM_ROOT=1). Every draw and dispatch copies the whole
+ * root descriptor table (about 2.2 KB) into fresh command buffer memory, and
+ * under Rosetta that copy is about a tenth of the encoder thread's time. The
+ * table ends with the descriptor set addresses and the dynamic buffers;
+ * shaders only read the set slots of sets that are bound, and the dynamic
+ * buffer area only when a bound set layout has dynamic descriptors. So when no
+ * dynamic buffers were bound, the upload can stop after the highest bound set.
+ */
+#ifndef SHADPS4_ROOT_TRIM_H
+#define SHADPS4_ROOT_TRIM_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Bytes of the root table to upload: everything up to `sets_offset`, then the
+ * set addresses up to the highest non-zero one, or `full_size` when dynamic
+ * buffers are in use. */
+static inline uint32_t
+kk_shadps4_root_upload_size(uint32_t sets_offset, uint32_t full_size,
+                            const uint64_t *sets, uint32_t num_sets,
+                            bool dynamic_buffers_used)
+{
+   if (dynamic_buffers_used)
+      return full_size;
+   uint32_t used = 0;
+   for (uint32_t i = num_sets; i > 0; i--) {
+      if (sets[i - 1] != 0) {
+         used = i;
+         break;
+      }
+   }
+   const uint32_t size = sets_offset + used * (uint32_t)sizeof(uint64_t);
+   return size < full_size ? size : full_size;
+}
+
+#endif
diff --git a/src/kosmickrisp/vulkan/test_shadps4_barrier_split.c b/src/kosmickrisp/vulkan/test_shadps4_barrier_split.c
new file mode 100644
index 0000000..32a12cf
--- /dev/null
+++ b/src/kosmickrisp/vulkan/test_shadps4_barrier_split.c
@@ -0,0 +1,156 @@
+/* SPDX-License-Identifier: MIT */
+#include "shadps4_barrier_split.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+static int failures;
+
+static void
+check(bool condition, const char *what)
+{
+   if (!condition) {
+      fprintf(stderr, "Barrier split test failed: %s\n", what);
+      failures++;
+   }
+}
+
+#define SHADER_W VK_ACCESS_2_SHADER_WRITE_BIT
+#define STORAGE_W VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT
+#define COLOR_W VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT
+#define DS_W VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT
+#define MEM_W VK_ACCESS_2_MEMORY_WRITE_BIT
+#define XFER_W VK_ACCESS_2_TRANSFER_WRITE_BIT
+#define SHADER_R VK_ACCESS_2_SHADER_READ_BIT
+#define VATTR_R VK_ACCESS_2_VERTEX_ATTRIBUTE_READ_BIT
+#define INPUT_R VK_ACCESS_2_INPUT_ATTACHMENT_READ_BIT
+#define DS_R VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT
+
+/* One barrier against a fresh encoder: the common case. */
+static bool
+single(VkAccessFlags2 src, VkAccessFlags2 dst, enum kk_shadps4_barrier_kind kind,
+       bool image_is_attachment, bool encoder_writes, bool has_ds)
+{
+   struct kk_shadps4_encoder_hazards h;
+   kk_shadps4_encoder_hazards_reset(&h);
+   const VkAccessFlags2 src_here =
+      kk_shadps4_attributable_writes(src, kind, image_is_attachment, encoder_writes);
+   return kk_shadps4_barrier_requires_split(src_here, dst, has_ds, &h);
+}
+
+int
+main(void)
+{
+   const enum kk_shadps4_barrier_kind MEMORY = KK_SHADPS4_BARRIER_MEMORY;
+   const enum kk_shadps4_barrier_kind BUFFER = KK_SHADPS4_BARRIER_BUFFER;
+   const enum kk_shadps4_barrier_kind IMAGE = KK_SHADPS4_BARRIER_IMAGE;
+
+   /* Attribution: writes recorded before the encoder are never attributable. */
+   check(kk_shadps4_attributable_writes(SHADER_W, BUFFER, false, false) == 0,
+         "compute write to a buffer, no memory writing draws");
+   check(kk_shadps4_attributable_writes(XFER_W, BUFFER, false, true) == 0,
+         "transfer writes never come from a render encoder");
+   check(kk_shadps4_attributable_writes(XFER_W | COLOR_W, IMAGE, false, true) == 0,
+         "attachment write to an image that is not an attachment here");
+   check(kk_shadps4_attributable_writes(SHADER_W | COLOR_W, BUFFER, false, true) ==
+            SHADER_W,
+         "buffer barrier keeps only shader writes when draws write memory");
+   check(kk_shadps4_attributable_writes(SHADER_W | COLOR_W, IMAGE, true, false) ==
+            COLOR_W,
+         "attachment image keeps attachment writes only");
+   check(kk_shadps4_attributable_writes(SHADER_W | COLOR_W, IMAGE, true, true) ==
+            (SHADER_W | COLOR_W),
+         "attachment image with memory writing draws keeps both");
+   check(kk_shadps4_attributable_writes(MEM_W, IMAGE, false, false) == 0,
+         "generic write on a foreign image, no memory writing draws");
+   check(kk_shadps4_attributable_writes(MEM_W, IMAGE, true, false) == MEM_W,
+         "generic write on an attachment image");
+   check(kk_shadps4_attributable_writes(MEM_W, BUFFER, false, true) == MEM_W,
+         "generic write on a buffer with memory writing draws");
+   check(kk_shadps4_attributable_writes(COLOR_W | DS_W | MEM_W, MEMORY, false, false) ==
+            (COLOR_W | DS_W | MEM_W),
+         "global barrier always keeps attachment and generic writes");
+   check(kk_shadps4_attributable_writes(SHADER_W, MEMORY, false, false) == 0,
+         "global barrier drops shader writes without memory writing draws");
+   check(kk_shadps4_attributable_writes(SHADER_W | STORAGE_W, MEMORY, false, true) ==
+            (SHADER_W | STORAGE_W),
+         "global barrier keeps shader writes with memory writing draws");
+
+   /* The case this change exists for: a draw inside an open pass reads a
+    * buffer that an earlier compute dispatch wrote. No split. */
+   check(!single(SHADER_W, SHADER_R, BUFFER, false, false, true),
+         "compute written buffer read by a draw: no split");
+   check(!single(SHADER_W, VATTR_R, BUFFER, false, false, true),
+         "compute written vertex buffer: no split");
+   check(!single(XFER_W, SHADER_R, BUFFER, false, false, true),
+         "uploaded buffer read by a draw: no split");
+   /* Texture written as an attachment by an earlier pass, sampled now. */
+   check(!single(COLOR_W, SHADER_R, IMAGE, false, false, true),
+         "earlier pass attachment sampled now: no split");
+   check(!single(DS_W, SHADER_R, IMAGE, false, false, true),
+         "earlier pass depth sampled now: no split");
+
+   /* Real feedback: the encoder's own attachment is read as a texture. */
+   check(single(COLOR_W, SHADER_R, IMAGE, true, false, true),
+         "own color attachment sampled: split");
+   check(single(DS_W, SHADER_R, IMAGE, true, false, true),
+         "own depth attachment sampled: split");
+   check(single(DS_W, INPUT_R, IMAGE, true, false, true),
+         "own depth attachment as input attachment: split");
+   check(!single(DS_W, INPUT_R, IMAGE, true, false, false),
+         "depth write flag needs a depth attachment to count (upstream rule)");
+   check(!single(COLOR_W, VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT, IMAGE, true, false,
+                 true),
+         "attachment write then attachment read: no split (upstream rule)");
+
+   /* Draw shaders that write memory keep the conservative behaviour. */
+   check(single(SHADER_W, SHADER_R, BUFFER, false, true, true),
+         "memory writing draws then buffer read: split");
+   check(single(STORAGE_W, INPUT_R, BUFFER, false, true, true),
+         "memory writing draws then input attachment read: split");
+   check(single(SHADER_W, SHADER_R, IMAGE, false, true, true),
+         "memory writing draws then storage image read: split");
+
+   /* Global memory barriers stay conservative for attachments. */
+   check(single(COLOR_W, SHADER_R, MEMORY, false, false, true),
+         "global barrier naming attachment writes: split");
+   check(single(MEM_W, VK_ACCESS_2_MEMORY_READ_BIT, MEMORY, false, false, true),
+         "global memory write to memory read: split");
+   check(!single(SHADER_W, SHADER_R, MEMORY, false, false, true),
+         "global barrier for compute writes only: no split");
+
+   /* Hazard flags persist within one encoder and reset with it. */
+   {
+      struct kk_shadps4_encoder_hazards h;
+      kk_shadps4_encoder_hazards_reset(&h);
+      VkAccessFlags2 src = kk_shadps4_attributable_writes(COLOR_W, IMAGE, true, false);
+      check(!kk_shadps4_barrier_requires_split(src, VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT,
+                                               true, &h),
+            "attachment write noted, no texture read yet");
+      check(h.write_available, "write_available set by attributable write");
+      src = kk_shadps4_attributable_writes(SHADER_W, BUFFER, false, false);
+      check(src == 0, "second barrier not attributable");
+      check(kk_shadps4_barrier_requires_split(src, SHADER_R, true, &h),
+            "later texture read in the same encoder still splits");
+      kk_shadps4_encoder_hazards_reset(&h);
+      check(!h.write_available && !h.ds_write_available && !h.storage_write_available,
+            "reset clears all flags");
+      check(!kk_shadps4_barrier_requires_split(0, SHADER_R, true, &h),
+            "fresh encoder, texture read, nothing to wait for");
+   }
+   {
+      struct kk_shadps4_encoder_hazards h;
+      kk_shadps4_encoder_hazards_reset(&h);
+      VkAccessFlags2 src = kk_shadps4_attributable_writes(SHADER_W, BUFFER, false, false);
+      kk_shadps4_barrier_requires_split(src, SHADER_R, true, &h);
+      check(!h.write_available && !h.storage_write_available,
+            "unattributable writes leave the flags clear");
+   }
+
+   if (failures) {
+      fprintf(stderr, "%d barrier split checks failed\n", failures);
+      return EXIT_FAILURE;
+   }
+   puts("Barrier split tests passed");
+   return EXIT_SUCCESS;
+}
diff --git a/src/kosmickrisp/vulkan/test_shadps4_cache_key.c b/src/kosmickrisp/vulkan/test_shadps4_cache_key.c
