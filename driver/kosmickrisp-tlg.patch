diff --git a/src/kosmickrisp/compiler/shadps4_diagnostic_name.h b/src/kosmickrisp/compiler/shadps4_diagnostic_name.h
new file mode 100644
index 0000000..d413071
--- /dev/null
+++ b/src/kosmickrisp/compiler/shadps4_diagnostic_name.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef SHADPS4_DIAGNOSTIC_NAME_H
+#define SHADPS4_DIAGNOSTIC_NAME_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <string.h>
+
+/* The emulator generates these ASCII identifiers only for opt-in profiling.
+ * Keep arbitrary application entrypoint names on the existing rename path.
+ */
+static inline bool
+kk_is_shadps4_diagnostic_name(const char *name)
+{
+   if (!name)
+      return false;
+
+   const char *prefixes[] = {"shadps4_guest_", "shadps4_host_tiling_"};
+   size_t prefix_length = 0;
+   for (size_t i = 0; i < sizeof(prefixes) / sizeof(prefixes[0]); ++i) {
+      size_t length = strlen(prefixes[i]);
+      if (strncmp(name, prefixes[i], length) == 0) {
+         prefix_length = length;
+         break;
+      }
+   }
+   if (!prefix_length || !name[prefix_length])
+      return false;
+
+   /* Bound both the accepted Metal identifier and the validation scan. */
+   for (size_t i = prefix_length; i < 128; ++i) {
+      unsigned char c = (unsigned char)name[i];
+      if (!c)
+         return true;
+      if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+            (c >= '0' && c <= '9') || c == '_'))
+         return false;
+   }
+   return false;
+}
+
+#endif
diff --git a/src/kosmickrisp/compiler/test_shadps4_diagnostic_name.c b/src/kosmickrisp/compiler/test_shadps4_diagnostic_name.c
new file mode 100644
index 0000000..9755f34
--- /dev/null
+++ b/src/kosmickrisp/compiler/test_shadps4_diagnostic_name.c
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: MIT */
+#include "shadps4_diagnostic_name.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+static void check(bool condition)
+{
+   if (!condition) {
+      fputs("Diagnostic shader name test failed\n", stderr);
+      abort();
+   }
+}
+
+int main(void)
+{
+   check(kk_is_shadps4_diagnostic_name(
+      "shadps4_guest_cs_0123456789abcdef_p12"));
+   check(kk_is_shadps4_diagnostic_name(
+      "shadps4_host_tiling_Thin1D_32_detiler_single"));
+   check(!kk_is_shadps4_diagnostic_name(NULL));
+   check(!kk_is_shadps4_diagnostic_name(""));
+   check(!kk_is_shadps4_diagnostic_name("main"));
+   check(!kk_is_shadps4_diagnostic_name("main_entrypoint"));
+   check(!kk_is_shadps4_diagnostic_name("shadps4_guest_"));
+   check(!kk_is_shadps4_diagnostic_name("shadps4_host_tiling_"));
+   check(!kk_is_shadps4_diagnostic_name("shadps4_guest_a b"));
+   check(!kk_is_shadps4_diagnostic_name("shadps4_guest_a-b"));
+   check(!kk_is_shadps4_diagnostic_name("shadps4_guest_a\n"));
+   check(!kk_is_shadps4_diagnostic_name("shadps4_guest_a\xc3\xa9"));
+   check(!kk_is_shadps4_diagnostic_name("shadps4_guest_;return"));
+   check(!kk_is_shadps4_diagnostic_name("shadps4_guest_(x)"));
+   check(!kk_is_shadps4_diagnostic_name("other_shadps4_guest_x"));
+   char boundary[129];
+   memset(boundary, 'a', sizeof(boundary));
+   memcpy(boundary, "shadps4_guest_", strlen("shadps4_guest_"));
+   boundary[127] = '\0';
+   check(kk_is_shadps4_diagnostic_name(boundary));
+   boundary[127] = 'a';
+   boundary[128] = '\0';
+   check(!kk_is_shadps4_diagnostic_name(boundary));
+   puts("Diagnostic shader name tests passed");
+   return 0;
+}
