diff --git a/src/kosmickrisp/vulkan/shadps4_barrier_split.h b/src/kosmickrisp/vulkan/shadps4_barrier_split.h
new file mode 100644
index 0000000..e65a59b
--- /dev/null
+++ b/src/kosmickrisp/vulkan/shadps4_barrier_split.h
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Render encoder split decision for pipeline barriers recorded inside a
+ * render pass (shadPS4 / The Last Guardian performance work).
+ *
+ * KosmicKrisp serializes Metal encoders: end_encoder() places a barrier after
+ * all stages of the finished encoder, so every write recorded before the
+ * active render encoder started is complete and visible to it. A barrier
+ * inside the encoder therefore only has to split it when the writes it
+ * names may have been produced by draws of that same encoder:
+ *
+ *  - attachment writes, when the barrier names an image bound as one of the
+ *    encoder's attachments (or is a global memory barrier, which names
+ *    everything);
+ *  - shader (storage) writes, when a draw of the encoder used a shader that
+ *    writes memory.
+ *
+ * Upstream treated every write bit in a barrier as if it could come from the
+ * active encoder, which split the encoder at every draw that read a buffer
+ * written by an earlier compute dispatch. On a tile based GPU each split
+ * stores and reloads every attachment.
+ *
+ * This header is plain C with no driver types so it can be unit tested on
+ * its own (test_shadps4_barrier_split.c).
+ */
+#ifndef SHADPS4_BARRIER_SPLIT_H
+#define SHADPS4_BARRIER_SPLIT_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <vulkan/vulkan_core.h>
+
+enum kk_shadps4_barrier_kind {
+   KK_SHADPS4_BARRIER_MEMORY, /* VkMemoryBarrier2: names all memory */
+   KK_SHADPS4_BARRIER_BUFFER, /* VkBufferMemoryBarrier2 */
+   KK_SHADPS4_BARRIER_IMAGE,  /* VkImageMemoryBarrier2 */
+};
+
+/* Hazard flags that live as long as one Metal render encoder. They are the
+ * same three flags upstream kept in kk_rendering_state. */
+struct kk_shadps4_encoder_hazards {
+   bool write_available;
+   bool ds_write_available;
+   bool storage_write_available;
+};
+
+static inline void
+kk_shadps4_encoder_hazards_reset(struct kk_shadps4_encoder_hazards *hazards)
+{
+   hazards->write_available = false;
+   hazards->ds_write_available = false;
+   hazards->storage_write_available = false;
+}
+
+#define KK_SHADPS4_ATTACHMENT_WRITES                                           \
+   (VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT |                                   \
+    VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT)
+#define KK_SHADPS4_SHADER_WRITES                                               \
+   (VK_ACCESS_2_SHADER_WRITE_BIT | VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT)
+#define KK_SHADPS4_GENERIC_WRITES (VK_ACCESS_2_MEMORY_WRITE_BIT)
+
+/* The subset of a barrier's source access mask whose writes may have been
+ * produced inside the active render encoder.
+ *
+ * kind                  : what the barrier names.
+ * image_is_attachment   : for image barriers, the image is bound as a color,
+ *                         depth, stencil, resolve or shading rate attachment
+ *                         of the active encoder.
+ * encoder_may_write_memory : a draw of the active encoder used a shader that
+ *                         writes memory (storage buffers or images).
+ */
+static inline VkAccessFlags2
+kk_shadps4_attributable_writes(VkAccessFlags2 src,
+                               enum kk_shadps4_barrier_kind kind,
+                               bool image_is_attachment,
+                               bool encoder_may_write_memory)
+{
+   VkAccessFlags2 out = 0;
+   switch (kind) {
+   case KK_SHADPS4_BARRIER_IMAGE:
+      if (image_is_attachment)
+         out |= src & (KK_SHADPS4_ATTACHMENT_WRITES | KK_SHADPS4_GENERIC_WRITES);
+      if (encoder_may_write_memory)
+         out |= src & (KK_SHADPS4_SHADER_WRITES | KK_SHADPS4_GENERIC_WRITES);
+      break;
+   case KK_SHADPS4_BARRIER_BUFFER:
+      /* Buffers are never attachments; only draw shaders can write them. */
+      if (encoder_may_write_memory)
+         out |= src & (KK_SHADPS4_SHADER_WRITES | KK_SHADPS4_GENERIC_WRITES);
+      break;
+   case KK_SHADPS4_BARRIER_MEMORY:
+      /* A global barrier may name the encoder's own attachments. */
+      out |= src & (KK_SHADPS4_ATTACHMENT_WRITES | KK_SHADPS4_GENERIC_WRITES);
+      if (encoder_may_write_memory)
+         out |= src & KK_SHADPS4_SHADER_WRITES;
+      break;
+   }
+   return out;
+}
+
+/* Upstream's split rule, fed only with attributable source writes. Updates
+ * the encoder's hazard flags and returns true when the render encoder must be
+ * ended and restarted before the work after the barrier. */
+static inline bool
+kk_shadps4_barrier_requires_split(VkAccessFlags2 attributable_src,
+                                  VkAccessFlags2 dst, bool has_ds,
+                                  struct kk_shadps4_encoder_hazards *hazards)
+{
+   const VkAccessFlags2 texture_read_access =
+      VK_ACCESS_2_SHADER_READ_BIT | VK_ACCESS_2_SHADER_SAMPLED_READ_BIT |
+      VK_ACCESS_2_SHADER_STORAGE_READ_BIT | VK_ACCESS_2_MEMORY_READ_BIT;
+   const VkAccessFlags2 any_write_access =
+      KK_SHADPS4_ATTACHMENT_WRITES | KK_SHADPS4_SHADER_WRITES |
+      KK_SHADPS4_GENERIC_WRITES;
+   const VkAccessFlags2 ds_write_access =
+      VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT |
+      VK_ACCESS_2_MEMORY_WRITE_BIT;
+   const VkAccessFlags2 storage_write_access =
+      KK_SHADPS4_SHADER_WRITES | KK_SHADPS4_GENERIC_WRITES;
+
+   if (attributable_src & any_write_access)
+      hazards->write_available = true;
+   if (has_ds && (attributable_src & ds_write_access))
+      hazards->ds_write_available = true;
+   if (attributable_src & storage_write_access)
+      hazards->storage_write_available = true;
+
+   if (hazards->write_available && (dst & texture_read_access))
+      return true;
+
+   return (hazards->ds_write_available || hazards->storage_write_available) &&
+          (dst & VK_ACCESS_2_INPUT_ATTACHMENT_READ_BIT);
+}
+
+#endif /* SHADPS4_BARRIER_SPLIT_H */
diff --git a/src/kosmickrisp/vulkan/shadps4_cache_key.h b/src/kosmickrisp/vulkan/shadps4_cache_key.h
