+/* KK_SHADPS4_GPU_TIMES=1 (diagnostics): one line per second with the committed command
+ * buffers' GPU execution time, the largest one, how long after the GPU finished the completion
+ * feedback arrived, and the GPU time between one command buffer ending and the next starting
+ * (idle with queued work if work was committed meanwhile). */
+#include <mach/mach_time.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "util/simple_mtx.h"
+
+static double
+kk_shadps4_host_seconds(void)
+{
+   static mach_timebase_info_data_t tb;
+   if (tb.denom == 0)
+      mach_timebase_info(&tb);
+   return (double)mach_absolute_time() * tb.numer / tb.denom / 1e9;
+}
+
+static void
+kk_shadps4_gpu_times(const struct mtl_feedback_data *data)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = getenv("KK_SHADPS4_GPU_TIMES") != NULL;
+   if (!enabled || data->gpu_end <= 0.0)
+      return;
+   static simple_mtx_t lock = SIMPLE_MTX_INITIALIZER;
+   static double window_start, busy, worst, lag, idle, last_end;
+   static unsigned count;
+   const double now = kk_shadps4_host_seconds();
+   simple_mtx_lock(&lock);
+   if (window_start == 0.0)
+      window_start = now;
+   const double dur = data->gpu_end - data->gpu_start;
+   busy += dur;
+   if (dur > worst)
+      worst = dur;
+   lag += now - data->gpu_end;
+   if (last_end > 0.0 && data->gpu_start > last_end)
+      idle += data->gpu_start - last_end;
+   if (data->gpu_end > last_end)
+      last_end = data->gpu_end;
+   count++;
+   if (now - window_start >= 1.0) {
+      fprintf(stderr,
+              "KK_GPU_TIMES dt=%.2fs cmdbufs=%u busy_ms=%.1f max_ms=%.2f feedback_lag_ms=%.2f "
+              "idle_ms=%.1f\n",
+              now - window_start, count, busy * 1e3, worst * 1e3, count ? lag * 1e3 / count : 0.0,
+              idle * 1e3);
+      window_start = now;
+      busy = worst = lag = idle = 0.0;
+      count = 0;
+   }
+   simple_mtx_unlock(&lock);
+}
+
+struct kk_shadps4_labeled_commit {
+   struct kk_device *dev;
+   char label[480];
+};
+
 static void
 commit_callback(struct mtl_feedback_data *data)
 {
    check_device_lost((struct kk_device *)data->user_data, data);
+   kk_shadps4_gpu_times(data);
+}
+
+/* KK_SHADPS4_GPU_TIMES: also names command buffers that ran over 4 ms on the GPU. */
+static void
+labeled_commit_callback(struct mtl_feedback_data *data)
+{
+   struct kk_shadps4_labeled_commit *commit = data->user_data;
+   data->user_data = commit->dev;
+   check_device_lost(commit->dev, data);
+   kk_shadps4_gpu_times(data);
+   const double ms = (data->gpu_end - data->gpu_start) * 1e3;
+   if (ms > 4.0)
+      fprintf(stderr, "KK_SLOW_CMDBUF ms=%.2f %s\n", ms, commit->label);
+   free(commit);
 }
 
