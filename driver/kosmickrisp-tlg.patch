+/* SPDX-License-Identifier: MIT */
+#include "shadps4_root_trim.h"
+
+#include <stdio.h>
+
+static int failures;
+
+static void
+check(bool condition, const char *what)
+{
+   if (!condition) {
+      fprintf(stderr, "Root trim test failed: %s\n", what);
+      failures++;
+   }
+}
+
+int
+main(void)
+{
+   uint64_t sets[32] = {0};
+   check(kk_shadps4_root_upload_size(960, 2240, sets, 32, false) == 960,
+         "no sets bound: stop at the set area");
+   sets[0] = 0x1000;
+   check(kk_shadps4_root_upload_size(960, 2240, sets, 32, false) == 968,
+         "set 0 bound: one slot");
+   sets[3] = 0x2000;
+   check(kk_shadps4_root_upload_size(960, 2240, sets, 32, false) == 992,
+         "set 3 bound: slots 0 to 3, including the unbound ones between");
+   check(kk_shadps4_root_upload_size(960, 2240, sets, 32, true) == 2240,
+         "dynamic buffers: whole table");
+   sets[31] = 0x3000;
+   check(kk_shadps4_root_upload_size(960, 1100, sets, 32, false) == 1100,
+         "never more than the table");
+   return failures ? 1 : 0;
+}
