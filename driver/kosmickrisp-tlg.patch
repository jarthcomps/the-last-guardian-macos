@@ -0,0 +1,10 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef MTL_KEEPALIVE_H
+#define MTL_KEEPALIVE_H 1
+
+#include "mtl_types.h"
+
+/* Starts the GPU keep-alive thread once (see mtl_keepalive.m). */
+void mtl_keepalive_start(mtl_device *device, double target_ms);
+
+#endif
diff --git a/src/kosmickrisp/bridge/mtl_keepalive.m b/src/kosmickrisp/bridge/mtl_keepalive.m
new file mode 100644
index 0000000..cc21ab7
--- /dev/null
+++ b/src/kosmickrisp/bridge/mtl_keepalive.m
@@ -0,0 +1,102 @@
+/*
+ * KK_SHADPS4_GPU_KEEPALIVE (shadPS4 / The Last Guardian): keeps a tiny compute kernel
+ * running on its own Metal queue so macOS keeps the GPU at its performance clocks.
+ *
+ * The game's frame is a chain: the emulator records a frame while the GPU waits, then the GPU
+ * runs it. When the GPU's own work gets shorter, it idles more, the GPU performance controller
+ * drops to its minimum clock, and every pass runs slower (measured: Maximum clock 100% of the
+ * time with the long serial compute chain, Minimum 71% once that chain ran in parallel, and the
+ * frame got slower). One threadgroup of 32 threads spinning on ALU work costs a sliver of one
+ * GPU core.
+ */
+#include "mtl_keepalive.h"
+
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static NSString *const kk_keepalive_source =
+   @"#include <metal_stdlib>\n"
+    "using namespace metal;\n"
+    "kernel void kk_keepalive(device uint *sink [[buffer(0)]], constant uint &n [[buffer(1)]],\n"
+    "                         uint t [[thread_position_in_grid]]) {\n"
+    "  uint x = t + 1u;\n"
+    "  for (uint i = 0; i < n; ++i) { x = x * 1664525u + 1013904223u; }\n"
+    "  if (x == 0x9e3779b9u) { sink[0] = x; }\n"
+    "}\n";
+
+struct kk_keepalive_args {
+   id<MTLDevice> device;
+   double target_seconds;
+};
+
+static void *
+kk_keepalive_thread(void *data)
+{
+   struct kk_keepalive_args *args = data;
+   @autoreleasepool {
+      NSError *error = nil;
+      id<MTLLibrary> library = [args->device newLibraryWithSource:kk_keepalive_source
+                                                          options:nil
+                                                            error:&error];
+      id<MTLFunction> function = [library newFunctionWithName:@"kk_keepalive"];
+      id<MTLComputePipelineState> pipeline =
+         function ? [args->device newComputePipelineStateWithFunction:function error:&error]
+                  : nil;
+      id<MTLCommandQueue> queue = [args->device newCommandQueue];
+      id<MTLBuffer> sink = [args->device newBufferWithLength:16
+                                                     options:MTLResourceStorageModePrivate];
+      if (!pipeline || !queue || !sink) {
+         fprintf(stderr, "KK_SHADPS4_GPU_KEEPALIVE: setup failed: %s\n",
+                 error ? error.localizedDescription.UTF8String : "unknown");
+         return NULL;
+      }
+      uint32_t n = 20000;
+      fprintf(stderr, "KK_SHADPS4_GPU_KEEPALIVE: running (%.1f ms per pass)\n",
+              args->target_seconds * 1e3);
+      for (;;) {
+         @autoreleasepool {
+            id<MTLCommandBuffer> cmd = [queue commandBuffer];
+            id<MTLComputeCommandEncoder> enc = [cmd computeCommandEncoder];
+            [enc setComputePipelineState:pipeline];
+            [enc setBuffer:sink offset:0 atIndex:0];
+            [enc setBytes:&n length:sizeof(n) atIndex:1];
+            [enc dispatchThreadgroups:MTLSizeMake(1, 1, 1)
+                threadsPerThreadgroup:MTLSizeMake(32, 1, 1)];
+            [enc endEncoding];
+            [cmd commit];
+            [cmd waitUntilCompleted];
+            const double took = cmd.GPUEndTime - cmd.GPUStartTime;
+            /* Steer the loop count toward the target pass length. */
+            if (took > 0.0) {
+               double scaled = (double)n * args->target_seconds / took;
+               if (scaled < 1000.0)
+                  scaled = 1000.0;
+               if (scaled > 50000000.0)
+                  scaled = 50000000.0;
+               n = (uint32_t)(0.7 * n + 0.3 * scaled);
+            }
+         }
+      }
+   }
+   return NULL;
+}
+
+void
+mtl_keepalive_start(mtl_device *device, double target_ms)
+{
+   static int started;
+   if (started++)
+      return;
+   struct kk_keepalive_args *args = calloc(1, sizeof(*args));
+   args->device = [(id<MTLDevice>)device retain];
+   args->target_seconds = (target_ms > 0.05 ? target_ms : 2.0) / 1e3;
+   pthread_t thread;
+   pthread_attr_t attr;
+   pthread_attr_init(&attr);
+   pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+   pthread_create(&thread, &attr, kk_keepalive_thread, args);
+   pthread_attr_destroy(&attr);
+}
